{
  "faction": "PlanB",
  "characters": [{
    "id": "plan_b_li_ling", "name": "李凌", "title": "B级条目",
    "rank": "NORMAL", "max_hp": 6, "base_max_duels": 2,
    "passive_skills": [
      {
        "name": "PlanB 组织",
        "entries": [{
          "trigger": "on_turn_start",
          "operation": {"op": "program", "code": [
            "$own_skills_in_hand", ["$self", 1, "TURN_DUELS_ADD", "$player", 1, "TURN_COST_ADD"], "WHEN"
          ]},
          "description": "回合开始时，若自己的三张技能都在手中，本回合自身交锋数+1，己方获得1通用费。"
        }]
      },
      {
        "name": "B级条目",
        "entries": [{"trigger": "on_turn_start", "operation": "Heal: 1", "target": "self",
                     "description": "初始交锋上限为2。回合开始时回复1生命值。"}]
      },
      {
        "name": "超·炎·刺剑",
        "entries": [
          {"trigger": "before_speed_roll", "operation": {"op": "program", "code": [
            "$die", "$self", "能源", "STATUS_COUNT", 4, "FLOOR_DIV", 2, "MIN", "DIE_LEVEL_ADD",
            "$value_ref", "$printed_min", "$self", "凝聚", "STATUS_COUNT", "ADD", "VALUE_FLOOR"
          ]}, "description": "每持有4能源，速度骰提升1级（至多2级）。每持有1凝聚，速度骰最小值+1。"},
          {"trigger": "BEFORE RESOLVE_DIE_LEVEL", "operation": {"op": "program", "code": [
            "$target_speed_lead", 2, "FLOOR_DIV", 0, 3, "CLAMP", "ADD"
          ]}, "description": "个人速度每领先目标2点，骰子等级+1（至多+3）。"},
          {"trigger": "BEFORE STATUS", "subject": "source", "when": {"status": "烧伤", "amount_at_least": 1},
           "operation": {"op": "program", "code": [
             "$target_speed_lead", 2, "FLOOR_DIV", 0, 3, "CLAMP", "ADD"
           ]}, "description": "个人速度每领先目标2点，本次施加的烧伤+1（至多+3）。"},
          {"trigger": "on_dice_hit", "when": {"one_sided": true}, "operation": {"op": "program", "code": [
            "$self", "$self", "迅捷", 1, "QUEUE_STATUS"
          ]}, "description": "自身骰子单方面攻击命中时，下回合获得1迅捷。"},
          {"trigger": "AFTER ACTIVATE_STATUS", "subject": "source",
           "when": {"status": "烧伤", "activation_kind": "ignite", "result": true},
           "operation": {"op": "program", "code": ["$self", "$target", "束缚", 1, "QUEUE_STATUS"]},
           "description": "每次自身触发引燃，下回合对引燃目标施加1束缚。"}
        ]
      },
      {
        "name": "洞穿",
        "entries": [{
          "trigger": "AFTER ACTIVATE_STATUS", "subject": "source",
          "when": {"status": "烧伤", "activation_kind": "ignite", "activation_die_type": "pierce", "result": true},
          "operation": {"op": "program", "code": [
            "$self", "凝聚", "STATUS_COUNT",
            ["$target_alive", "$target", "烧伤", "STATUS_COUNT", 0, "GT", "AND",
             [1, 20, "RANDOM_INT", "$target", "烧伤", "STATUS_COUNT", "LE"], [false], "IF_ELSE"],
            [{"op":"ignite", "from_die":true, "final_divisor":2}], "REPEAT_WHILE"
          ]},
          "description": "自身突刺骰引燃后，掷1～20，若不高于目标剩余烧伤，再引燃一次。重复引燃最终伤害减半并向上取整。每次原始引燃至多追加等于凝聚层数的次数。"
        }]
      },
      {
        "name": "能源聚集",
        "entries": [{
          "trigger": "on_status_changed", "subject": "target", "when": {"status":"能源"},
          "operation": {"op":"program","code":[
            "$actual_delta", 0, "LT", [
              "$self", "能源消耗余量", "CHARACTER_STATE", "$actual_delta", "SUB", "total", "STORE",
              {"local":"total"}, 8, "FLOOR_DIV", "earned", "STORE",
              "$self", "能源消耗余量", {"local":"total"}, {"local":"earned"}, 8, "MUL", "SUB", "SET_CHARACTER_STATE",
              {"local":"earned"}, 0, "GT", ["$self", "凝聚", {"local":"earned"}, "STATUS"], "WHEN"
            ], "WHEN"
          ]}, "description":"每累计实际消耗8能源，获得1凝聚，余数跨回合保留。"
        }]
      }
    ],
    "skills": [
      {
        "id": "li_ling_cycle", "name": "能源循环", "cost": 1,
        "entries": [
          {"trigger":"on_skill_use", "operation":{"op":"program","code":["$self","能源",4,"STATUS"]},
           "description":"使用时获得4能源。"},
          {"trigger":"before_dice_use", "operation":{"op":"program","code":["$die","$self","凝聚","STATUS_COUNT","DIE_FINAL_ADD"]},
           "description":"每持有1凝聚，本技能最终点数+1。"}
        ],
        "dice": [
          {"type":"evade","level":2,"entries":[
            {"trigger":"on_clash_win","operation":{"op":"program","code":["$self","$self","迅捷",1,"QUEUE_STATUS"]},
             "description":"拼点胜利后，下回合获得1迅捷。"}
          ]},
          {"type":"pierce","level":1,"entries":["1穿甲",
            {"trigger":"on_dice_hit","operation":{"op":"program","code":["$self","能源",2,"$self","凝聚","STATUS_COUNT","ADD","STATUS"]},
             "description":"命中获得2能源，自己每有1凝聚额外获得1能源。"}
          ]}
        ]
      },
      {
        "id":"li_ling_chain", "name":"连环穿刺", "cost":2,
        "entries":[
          {"trigger":"on_skill_use","operation":{"op":"program","code":[
            "$opponent_player","烧伤","DUEL_STATUS_LOST",4,"FLOOR_DIV","bands","STORE",
            "$owner",{"local":"bands"},"$owner","烧伤档位","SKILL_STATE","SUB",2,"MUL","SKILL_FINAL_ADD",
            "$owner","烧伤档位",{"local":"bands"},"SET_SKILL_STATE"
          ]}, "description":"本交锋内对方每失去4烧伤，本技能最终点数+2，计入本技能使用前的消耗。"},
          {"trigger":"on_status_changed","subject":"enemy","when":{"status":"烧伤"},"operation":{"op":"program","code":[
            "$actual_delta",0,"LT",[
              "$opponent_player","烧伤","DUEL_STATUS_LOST",4,"FLOOR_DIV","bands","STORE",
              "$owner",{"local":"bands"},"$owner","烧伤档位","SKILL_STATE","SUB",2,"MUL","SKILL_FINAL_ADD",
              "$owner","烧伤档位",{"local":"bands"},"SET_SKILL_STATE"
            ],"WHEN"
          ]}, "description":"交锋中的烧伤继续减少时，立即更新本技能最终点数。"},
          {"trigger":"AFTER ACTIVATE_STATUS","subject":"source","when":{"status":"烧伤","activation_kind":"ignite","result":true},
           "operation":{"op":"program","code":["$owner","引燃次数","$owner","引燃次数","SKILL_STATE",1,"ADD","SET_SKILL_STATE"]},
           "description":"记录本技能持续期间自身触发的每次引燃。"},
          {"trigger":"after_skill_use","operation":{"op":"program","code":[
            "$owner","引燃次数","SKILL_STATE","count","STORE",{"local":"count"},0,"GT",
            ["$self","能源",{"local":"count"},"STATUS"],"WHEN"
          ]},"description":"使用后，每触发一次引燃，获得1能源。"}
        ],
        "dice":[
          {"type":"pierce","level":3,"resource_cost":{"status":"能源","amount":4},"entries":["引燃"]},
          {"type":"pierce","level":2,"entries":[{"trigger":"on_dice_hit","operation":{"op":"program","code":["$target","烧伤",3,"STATUS"]},"description":"施加3烧伤。"}]},
          {"type":"pierce","level":2,"resource_cost":{"status":"能源","amount":2},"entries":["引燃"]},
          {"type":"pierce","level":1,"entries":[{"trigger":"on_dice_hit","operation":{"op":"program","code":["$target","烧伤",3,"STATUS"]},"description":"施加3烧伤。"}]}
        ]
      },
      {
        "id":"li_ling_sky", "name":"机动·贯彻长空", "cost":3,
        "pre_reveal_requires_status":{"凝聚":3},
        "range_level_when":{"speed_lead":4,"amount":1}, "ignore_range_when":{"speed_lead":4,"amount":3},
        "entries":[
          {"trigger":"on_skill_use","operation":{"op":"program","code":[
            "$self","能源",8,"SPEND_STATUS_IN_FULL",["$owner","增压",true,"SET_SKILL_STATE"],"WHEN"
          ]}, "description":"使用时消耗8能源以使本技能所有骰子基础值+2。"},
          {"trigger":"before_dice_use","operation":{"op":"program","code":[
            "$owner","增压","SKILL_STATE",["$die",2,"DIE_BASE_ADD"],"WHEN"
          ]},"description":"付足能源后每颗骰子基础值+2。"}
        ],
        "dice":[
          {"type":"pierce","level":3,"entries":["3穿甲",{"trigger":"on_dice_hit","operation":{"op":"program","code":[
            "$self","$self","迅捷",2,"QUEUE_STATUS"
          ]},"description":"下回合获得2迅捷。"}]},
          {"type":"pierce","level":3,"multiplier":2,"entries":["引燃"]}
        ]
      }
    ]
  }]
}
