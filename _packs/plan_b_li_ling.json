{
  "faction": "PlanB",
  "characters": [{
    "id": "plan_b_li_ling", "name": "李凌", "title": "B级条目",
    "rank": "NORMAL", "max_hp": 6, "base_max_duels": 2,
    "passive_skills": [
      {
        "name": "PlanB 组织",
        "entries": [{
          "trigger": "on_turn_start",
          "operation": {
            "op": "program",
            "code": [
              "$self.skills",
              [
                "$event.item.out_of_combat", "NOT", "$player.cardspace.hand.content", "$event.item",
                "CONTAINS", "AND"
              ],
              "FILTER", "SIZE", 3, "GE", ["$self",1,"TURN_DUELS_ADD","$player",1,"TURN_COST_ADD"],
              "WHEN"
            ]
          },
          "description": "【回合开始】若自己的三张技能都在手中，本回合自身交锋数+1，己方获得1通用费。"
        }]
      },
      {
        "name": "B级条目",
        "entries": [{"trigger": "on_turn_start", "operation": "HEAL 1", "target": "self",
                     "description": "初始交锋上限为2。【回合开始】回复1生命值。"}]
      },
      {
        "name": "超·炎·刺剑",
        "entries": [
          {"trigger": "before_speed_roll", "operation": {
            "op": "program",
            "code": [
              "$event.die", "$self", "能源", "STATUS_COUNT", 4, "FLOOR_DIV", 2, "MIN", "DIE_LEVEL_ADD",
              "$event.value_ref", "$event.printed_min", "$self", "凝聚", "STATUS_COUNT", "ADD",
              "VALUE_FLOOR"
            ]
          }, "description": "每持有4能源，速度骰提升1级（至多2级）。每持有1凝聚，速度骰最小值+1。"},
          {
            "trigger": "BEFORE RESOLVE_DIE_LEVEL",
            "operation": {
              "op": "program",
              "code": [
                "$event.target", "DUP", "NOT", ["POP","$event.card","SELECT_SKILL_TARGET"], "WHEN",
                "skill_recipient", "STORE", "$local.skill_recipient",
                ["$self.speed","$local.skill_recipient.speed","SUB",2,"FLOOR_DIV",0,3,"CLAMP","ADD"],
                "WHEN"
              ]
            },
            "description": "个人速度每领先目标2点，骰子等级+1（至多+3）。"
          },
          {
            "trigger": "BEFORE STATUS",
            "subject": "source",
            "when": [{"left":"$event.status","op":"eq","right":"烧伤"},{"left":"$pending.amount","op":"ge","right":1}],
            "operation": {
              "op": "program",
              "code": [
                "$event.target", "DUP", "NOT", ["POP","$event.card","SELECT_SKILL_TARGET"], "WHEN",
                "skill_recipient", "STORE", "$local.skill_recipient",
                ["$self.speed","$local.skill_recipient.speed","SUB",2,"FLOOR_DIV",0,3,"CLAMP","ADD"],
                "WHEN"
              ]
            },
            "description": "个人速度每领先目标2点，本次施加的烧伤+1（至多+3）。"
          },
          {"trigger": "on_dice_hit", "when": [{"left":"$event.one_sided","op":"eq","right":true}],
           "operation": {"schedule": {
             "event": "on_turn_prepared", "source": "$self", "target": "$self",
             "after_turns": 1, "through_turns": 1, "uses": 1,
             "require_source_alive": false, "require_target_alive": true,
             "then": ["$event.scheduled.target","迅捷",1,"STATUS"]
           }},
           "description": "【命中时】自身骰子单方面攻击命中时，下回合获得1迅捷。"},
          {"trigger": "AFTER ACTIVATE_STATUS", "subject": "source",
           "when": [
             {"left":"$event.status","op":"eq","right":"烧伤"},
             {"left":"$event.activation_kind","op":"eq","right":"ignite"},
             {"left":"$event.result","op":"eq","right":true}
           ],
           "operation": {"schedule": {
             "event": "on_turn_prepared", "source": "$self", "target": "$event.target",
             "after_turns": 1, "through_turns": 1, "uses": 1,
             "require_source_alive": false, "require_target_alive": true,
             "then": ["$event.scheduled.target","束缚",1,"STATUS"]
           }},
           "description": "每次自身触发引燃，下回合对引燃目标施加1束缚。"}
        ]
      },
      {
        "name": "洞穿",
        "entries": [{
          "trigger": "AFTER ACTIVATE_STATUS",
          "subject": "source",
          "when": [
            {"left":"$event.status","op":"eq","right":"烧伤"},
            {"left":"$event.activation_kind","op":"eq","right":"ignite"},
            {"left":"$event.activation_die_type","op":"eq","right":"pierce"},
            {"left":"$event.result","op":"eq","right":true}
          ],
          "operation": {
            "op": "program",
            "code": [
              "$self", "凝聚", "STATUS_COUNT",
              [
                "$event.target.is_alive", "$event.target", "烧伤", "STATUS_COUNT", 0, "GT", "AND",
                [1,20,"RANDOM_INT","$event.target","烧伤","STATUS_COUNT","LE"], [false], "IF_ELSE"
              ],
              [{"keyword":"ignite","credit":"activation_die","adjustments":{"final_damage":[2,"CEIL_DIV"]}}],
              "REPEAT_WHILE"
            ]
          },
          "description": "自身突刺骰引燃后，掷1～20，若不高于目标剩余烧伤，再引燃一次。重复引燃最终伤害减半并向上取整。每次原始引燃至多追加等于凝聚层数的次数。"
        }]
      },
      {
        "name": "能源聚集",
        "entries": [{
          "trigger": "on_status_changed", "subject": "target", "when": [{"left":"$event.status","op":"eq","right":"能源"}],
          "operation": {
            "op": "program",
            "code": [
              "$event.actual_delta", 0, "LT",
              [
                "$self.rule_state", "能源消耗余量", 0, "LOOKUP", "$event.actual_delta", "SUB", "total",
                "STORE", "DIVMOD $local.total 8", "remainder", "STORE", "earned", "STORE", "$self",
                "能源消耗余量", "$local.remainder", "SET_CHARACTER_STATE", {"local":"earned"}, 0, "GT",
                ["$self","凝聚",{"local":"earned"},"STATUS"], "WHEN"
              ],
              "WHEN"
            ]
          }, "description":"每累计实际消耗8能源，获得1凝聚，余数跨回合保留。"
        }]
      }
    ],
    "skills": [
      {
        "id": "li_ling_cycle", "name": "能源循环", "cost": 1,
        "entries": [
          {"trigger":"on_skill_use", "operation":"STATUS 能源 4 $self",
           "description":"【使用时】获得4能源。"},
          {"trigger":"before_dice_use", "operation":{"op":"program","code":["$event.die","$self","凝聚","STATUS_COUNT","DIE_FINAL_ADD"]},
           "description":"每持有1凝聚，本技能最终点数+1。"}
        ],
        "dice": [
          {"type":"evade","level":2,"entries":[
            {"trigger":"on_clash_win", "operation": {"schedule": {
               "event": "on_turn_prepared", "source": "$self", "target": "$self",
               "after_turns": 1, "through_turns": 1, "uses": 1,
               "require_source_alive": false, "require_target_alive": true,
               "then": ["$event.scheduled.target","迅捷",1,"STATUS"]
             }},
             "description":"【拼点胜利】下回合获得1迅捷。"}
          ]},
          {"type":"pierce","level":1,"entries":["1穿甲",
            {"trigger":"on_dice_hit","operation":{"op":"program","code":["$self","能源",2,"$self","凝聚","STATUS_COUNT","ADD","STATUS"]},
             "description":"【命中时】获得2能源，自己每有1凝聚额外获得1能源。"}
          ]}
        ]
      },
      {
        "id":"li_ling_chain", "name":"连环穿刺", "cost":2,
        "entries":[
          {"trigger":"on_skill_use","operation":{
            "op": "program",
            "code": [
              "$player", "OPPONENT", {"field":"side"}, "烧伤", "PAIR", "$game.resolving_duel.status_lost",
              "SWAP", 0, "LOOKUP", 4, "FLOOR_DIV", "bands", "STORE", "$owner", {"local":"bands"},
              "$owner.use_state", "烧伤档位", 0, "LOOKUP", "SUB", 2, "MUL", "SKILL_FINAL_ADD", "$owner",
              "烧伤档位", {"local":"bands"}, "SET_SKILL_STATE"
            ]
          }, "description":"【使用时】本交锋内对方每失去4烧伤，本技能最终点数+2，计入本技能使用前的消耗。"},
          {"trigger":"on_status_changed","subject":"enemy","when":[{"left":"$event.status","op":"eq","right":"烧伤"}],"operation":{
            "op": "program",
            "code": [
              "$event.actual_delta", 0, "LT",
              [
                "$player", "OPPONENT", {"field":"side"}, "烧伤", "PAIR",
                "$game.resolving_duel.status_lost", "SWAP", 0, "LOOKUP", 4, "FLOOR_DIV", "bands",
                "STORE", "$owner", {"local":"bands"}, "$owner.use_state", "烧伤档位", 0, "LOOKUP", "SUB", 2,
                "MUL", "SKILL_FINAL_ADD", "$owner", "烧伤档位", {"local":"bands"}, "SET_SKILL_STATE"
              ],
              "WHEN"
            ]
          }, "description":"交锋中的烧伤继续减少时，立即更新本技能最终点数。"},
          {"trigger":"AFTER ACTIVATE_STATUS","subject":"source","when":[
            {"left":"$event.status","op":"eq","right":"烧伤"},
            {"left":"$event.activation_kind","op":"eq","right":"ignite"},
            {"left":"$event.result","op":"eq","right":true}
          ],
           "operation":{
             "op": "program",
             "code": ["$owner","引燃次数","$owner.use_state","引燃次数",0,"LOOKUP",1,"ADD","SET_SKILL_STATE"]
           },
           "description":"记录本技能持续期间自身触发的每次引燃。"},
          {"trigger":"after_skill_use","operation":{
            "op": "program",
            "code": [
              "$owner.use_state", "引燃次数", 0, "LOOKUP", "count", "STORE", {"local":"count"}, 0, "GT",
              ["$self","能源",{"local":"count"},"STATUS"], "WHEN"
            ]
          },"description":"【使用后】每触发一次引燃，获得1能源。"}
        ],
        "dice":[
          {"type":"pierce","level":3,"resource_cost":{"status":"能源","amount":4},"entries":["引燃"]},
          {"type":"pierce","level":2,"entries":[{"trigger":"on_dice_hit","operation":"STATUS 烧伤 3 $event.target","description":"【命中时】施加3烧伤。"}]},
          {"type":"pierce","level":2,"resource_cost":{"status":"能源","amount":2},"entries":["引燃"]},
          {"type":"pierce","level":1,"entries":[{"trigger":"on_dice_hit","operation":"STATUS 烧伤 3 $event.target","description":"【命中时】施加3烧伤。"}]}
        ]
      },
      {
        "id":"li_ling_sky", "name":"机动·贯彻长空", "cost":3,
        "pre_reveal_requires_status":{"凝聚":3},
        "range_level_amount":{
          "value": {
            "if": {
              "if": "$event.card.range_target",
              "then": {
                "left": {"left":"$self.speed","op":"sub","right":"$event.card.range_target.speed"},
                "op": "ge",
                "right": 4
              },
              "else": false
            },
            "then": 1,
            "else": 0
          },
          "description": "个人速度领先目标至少4时，获得1级远程。"
        }, "ignore_range_amount":{
          "value": {
            "if": {
              "if": "$event.card.range_target",
              "then": {
                "left": {"left":"$self.speed","op":"sub","right":"$event.card.range_target.speed"},
                "op": "ge",
                "right": 4
              },
              "else": false
            },
            "then": 3,
            "else": 0
          },
          "description": "个人速度领先目标至少4时，无视3级远程。"
        },
        "entries":[
          {"trigger":"on_skill_use","operation":{
            "op": "program",
            "code": [
              "$self", "能源", 8,
              {"call":"SPEND_STATUS","with":{"require_full":true},"result":"paid_in_full","default":false},
              ["$owner","增压",true,"SET_SKILL_STATE"], "WHEN"
            ]
          }, "description":"【使用时】消耗8能源以使本技能所有骰子基础值+2。"},
          {"trigger":"before_dice_use","operation":{
            "op": "program",
            "code": ["$owner.use_state","增压",false,"LOOKUP",["$event.die",2,"DIE_BASE_ADD"],"WHEN"]
          },"description":"付足能源后每颗骰子基础值+2。"}
        ],
        "dice":[
          {"type":"pierce","level":3,"entries":["3穿甲",{"trigger":"on_dice_hit",
            "operation": {"schedule": {
              "event": "on_turn_prepared", "source": "$self", "target": "$self",
              "after_turns": 1, "through_turns": 1, "uses": 1,
              "require_source_alive": false, "require_target_alive": true,
              "then": ["$event.scheduled.target","迅捷",2,"STATUS"]
            }},
            "description":"【命中时】下回合获得2迅捷。"}]},
          {"type":"pierce","level":3,"multiplier":2,"entries":["引燃"]}
        ]
      }
    ]
  }]
}
