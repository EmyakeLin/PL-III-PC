        {
          "id": "liu_invisible",
          "name": "无形杀",
          "cost": 0,
          "ignore_range": 3,
          "anytime_play": ["place"],
          "anytime_replace": true,
          "entries": [
            {
              "trigger": "on_skill_use",
              "description": "使用时能源至少12，本技能的骰子每次命中可支付6能源以重复使用。",
              "operation": {
                "op": "program",
