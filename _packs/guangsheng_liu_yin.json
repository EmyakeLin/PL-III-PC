{
  "faction": "光生会",
  "faction_passives": [
    {
      "name": "光生会：心河",
      "entries": [
        {
          "trigger": "on_turn_start",
          "description": "回合开始时，己方手牌不少于5张获得1领域洞悉，不少于9张再获得1层。",
          "operation": {
            "op": "program",
            "code": [
              "$player.cardspace.hand.content", "SIZE", "hand", "STORE", "$local.hand", 5, "GE",
              ["$self","领域洞悉",1,"STATUS"],
              "WHEN", "$local.hand", 9, "GE",
              ["$self","领域洞悉",1,"STATUS"],
              "WHEN"
            ]
          }
        }
      ]
    }
  ],
  "status_rules": {
    "领域洞悉": {"cap":30,"description":"每15层使骰子等级提升1。"},
    "环境压制": {"cap":18,"description":"生命不高于层数时，获得50%强化护甲减伤。"},
    "环境同调": {"cap":3,"description":"每层提高1费用上限，3层时再提高1。","sustain_from":2,"sustain":{"强壮":1,"迅捷":1}},
    "战甲": {"cap":1,"description":"领域洞悉的实际增量同时转化为等量能源。"}
  },
  "status_entries": {
    "领域洞悉": [
      {
        "trigger": "BEFORE RESOLVE_DIE_LEVEL",
        "description": "每15层使骰级提升1，最多2级。",
        "operation": {"op":"program","code":["$self","领域洞悉","STATUS_COUNT",15,"FLOOR_DIV",2,"MIN","ADD"]}
      }
    ],
    "环境同调": [
      {
        "trigger": "BEFORE RESET_COST",
        "description": "双方回合回补费用时，每层同调增加1通用费上限，3层时另加1。",
        "when": [
          {"left":"$event.player","op":"eq","right":"$self.player"},
          {"left":"$event.refill","op":"eq","right":true}
        ],
        "operation": {
          "op": "program",
          "code": [
            "SWAP", "$self", "环境同调", "STATUS_COUNT", "ADD", "$self", "环境同调", "STATUS_COUNT", 3, "EQ",
            [1,"ADD"],
            "WHEN", "SWAP"
          ]
        }
      }
    ],
    "环境压制": [
      {
        "trigger": "BEFORE DAMAGE",
        "description": "生命不高于环境压制层数时，受到的普通和穿甲伤害减半。",
        "when": [{"left":"$self.hp","op":"le","right":{"field":"$self.statuses","key":"环境压制","default":0}}],
        "operation": {"op":"program","code":["$self","$event.modifiers","damage_multiply",0.5,"pierce","ADD_DAMAGE_MODIFIER"]},
        "subject": "target"
      }
    ]
  },
  "characters": [
    {
      "id": "liu_yin",
      "name": "流阴",
      "title": "执政",
      "rank": "EMPOWERED_BOSS",
      "max_hp": 18,
      "passive_skills": [
        {
          "name": "行至阴处",
          "entries": [
            {
              "trigger": "on_battle_start",
              "description": "战斗开始时获得18环境压制。",
              "operation": {"op":"program","code":["$self","环境压制",18,"STATUS"]}
            },
            {
              "trigger": "on_turn_limits_reset",
              "description": "新回合刷新首张技能标记。",
              "operation": {"op":"program","code":["$self","已用首张",false,"SET_CHARACTER_STATE"]}
            },
            {
              "trigger": "BEFORE PAY_COST",
              "description": "每回合使用的第一张技能费用−1。",
              "when": [{"left":{"field":"$self.rule_state","key":"已用首张","default":false},"op":"eq","right":false}],
              "operation": {"op":"program","code":[1,"SUB",0,"MAX"]},
              "subject": "source"
            },
            {
              "trigger": "AFTER PAY_COST",
              "description": "成功付款时登记本回合首张技能。",
              "when": [
                {"left":"$event.result","op":"eq","right":true},
                {"left":{"field":"$self.rule_state","key":"已用首张","default":false},"op":"eq","right":false}
              ],
              "operation": {
                "op": "program",
                "code": ["$self","已用首张",true,"SET_CHARACTER_STATE","$event.card","回合首张",true,"SET_SKILL_STATE"]
              },
              "subject": "source"
            },
            {
              "trigger": "after_skill_use",
              "description": "首张技能使用后减少1环境压制。",
              "operation": {
                "op": "program",
                "code": ["$event.card.use_state","回合首张",false,"LOOKUP",["$self","环境压制",-1,"STATUS"],"WHEN"]
              }
            },
            {
              "trigger": "on_status_changed",
              "description": "环境压制首次减少至0时，获得12领域洞悉。",
              "when": [
                {"left":"$event.status","op":"eq","right":"环境压制"},
                {"left":"$event.previous_stacks","op":"gt","right":0},
                {"left":"$event.current_stacks","op":"eq","right":0},
                {"left":{"field":"$self.rule_state","key":"天性解放","default":false},"op":"eq","right":false}
              ],
              "operation": {"op":"program","code":["$self","天性解放",true,"SET_CHARACTER_STATE","$self","领域洞悉",12,"STATUS"]}
            }
          ]
        },
        {
          "name": "影剑·光枪·残影机甲",
          "entries": [
            {
              "trigger": "on_status_changed",
              "description": "在战甲状态获得领域洞悉时，按实得数量获得能源。",
              "when": [
                {"left":"$event.status","op":"eq","right":"领域洞悉"},
                {"left":"$event.actual_delta","op":"gt","right":0},
                {"left":{"field":"$self.statuses","key":"战甲","default":0},"op":"ge","right":1}
              ],
              "operation": {"op":"program","code":["$self","能源","$event.actual_delta","STATUS"]}
            },
            {
              "trigger": "on_status_changed",
              "description": "领域洞悉每首次达到10的倍数，下回合开牌前免费使用一次领域覆写，任选一名存活敌方。",
              "when": [
                {"left":"$event.status","op":"eq","right":"领域洞悉"},
                {"left":"$event.actual_delta","op":"gt","right":0}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.current_stacks", 10, "GE", "$self.rule_state", "洞悉档位", 0, "LOOKUP", 10, "LT", "AND",
                  [
                    "$self", "洞悉档位", 10, "SET_CHARACTER_STATE",
                    {
                      "schedule": {
                        "event": "on_before_reveal_phase_start",
                        "source": "$self",
                        "target": "$self",
                        "after_turns": 1,
                        "through_turns": 1,
                        "uses": 1,
                        "require_source_alive": true,
                        "require_target_alive": true,
                        "when": [],
                        "capture": {},
                        "then": [
                          "$self", "$self.skills",
                          ["$event.item.id","liu_overwrite","EQ"],
                          "FILTER", "FIRST",
                          {"field":"printed_data"},
                          "SKILL_COPY",
                          {"literal":{"prepaid":true}},
                          "SKILL_USE", "$player", "SELECT_ENEMY_CHARACTER", "STAGE_PRE_ATTACK"
                        ]
                      }
                    }
                  ],
                  "WHEN", "$event.current_stacks", 20, "GE", "$self.rule_state", "洞悉档位", 0, "LOOKUP", 20, "LT",
                  "AND",
                  [
                    "$self", "洞悉档位", 20, "SET_CHARACTER_STATE",
                    {
                      "schedule": {
                        "event": "on_before_reveal_phase_start",
                        "source": "$self",
                        "target": "$self",
                        "after_turns": 1,
                        "through_turns": 1,
                        "uses": 1,
                        "require_source_alive": true,
                        "require_target_alive": true,
                        "when": [],
                        "capture": {},
                        "then": [
                          "$self", "$self.skills",
                          ["$event.item.id","liu_overwrite","EQ"],
                          "FILTER", "FIRST",
                          {"field":"printed_data"},
                          "SKILL_COPY",
                          {"literal":{"prepaid":true}},
                          "SKILL_USE", "$player", "SELECT_ENEMY_CHARACTER", "STAGE_PRE_ATTACK"
                        ]
                      }
                    }
                  ],
                  "WHEN", "$event.current_stacks", 30, "GE", "$self.rule_state", "洞悉档位", 0, "LOOKUP", 30, "LT",
                  "AND",
                  [
                    "$self", "洞悉档位", 30, "SET_CHARACTER_STATE",
                    {
                      "schedule": {
                        "event": "on_before_reveal_phase_start",
                        "source": "$self",
                        "target": "$self",
                        "after_turns": 1,
                        "through_turns": 1,
                        "uses": 1,
                        "require_source_alive": true,
                        "require_target_alive": true,
                        "when": [],
                        "capture": {},
                        "then": [
                          "$self", "$self.skills",
                          ["$event.item.id","liu_overwrite","EQ"],
                          "FILTER", "FIRST",
                          {"field":"printed_data"},
                          "SKILL_COPY",
                          {"literal":{"prepaid":true}},
                          "SKILL_USE", "$player", "SELECT_ENEMY_CHARACTER", "STAGE_PRE_ATTACK"
                        ]
                      }
                    }
                  ],
                  "WHEN"
                ]
              }
            },
            {
              "trigger": "BEFORE DAMAGE",
              "description": "近战斩击的非百分比物理伤害转为三倍加一光点。",
              "when": [
                {"left":{"field":"$self.statuses","key":"环境同调","default":0},"op":"ge","right":1},
                {"left":"$event.penetration","op":"eq","right":"normal"},
                {"left":"$event.damage_die.type","op":"eq","right":"slash"},
                {"left":"$event.damage_die.paired_range","op":"eq","right":0},
                {"left":"$event.percentage_damage","op":"eq","right":false}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.target", "$event.amount", 3, "MUL", 1, "ADD",
                  {"call":"LIGHTCORE_DAMAGE","with":{"credit":"damage_die"}},
                  {"op":"cancel"}
                ]
              },
              "subject": "source"
            },
            {
              "trigger": "BEFORE DAMAGE",
              "description": "远程突刺的非百分比物理伤害转为三倍加一光点。",
              "when": [
                {"left":{"field":"$self.statuses","key":"环境同调","default":0},"op":"ge","right":2},
                {"left":"$event.penetration","op":"eq","right":"normal"},
                {"left":"$event.damage_die.type","op":"eq","right":"pierce"},
                {"left":"$event.damage_die.paired_range","op":"gt","right":0},
                {"left":"$event.percentage_damage","op":"eq","right":false}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.target", "$event.amount", 3, "MUL", 1, "ADD",
                  {"call":"LIGHTCORE_DAMAGE","with":{"credit":"damage_die"}},
                  {"op":"cancel"}
                ]
              },
              "subject": "source"
            },
            {
              "trigger": "AFTER DAMAGE",
              "description": "三层同调时，每次实际造成物理伤害后追加等量光点。",
              "when": [
                {"left":{"field":"$self.statuses","key":"环境同调","default":0},"op":"ge","right":3},
                {"left":"$event.penetration","op":"eq","right":"normal"},
                {"left":"$event.damage_dealt","op":"eq","right":true}
              ],
              "operation": {"op":"program","code":["$event.target","$event.damage_amount","LIGHTCORE_DAMAGE"]},
              "subject": "source"
            },
            {
              "trigger": "AFTER LIGHTCORE_DAMAGE",
              "description": "三层同调时，自身造成崩塌即回复3生命。",
              "when": [
                {"left":{"field":"$self.statuses","key":"环境同调","default":0},"op":"ge","right":3},
                {"left":"$event.lightcore_collapsed","op":"eq","right":true}
              ],
              "operation": {"op":"program","code":["$self",3,"HEAL"]},
              "subject": "source",
              "reentrant": true
            }
          ]
        },
        {
          "name": "篡改万物，灭杀万物，创造万物",
          "entries": [
            {
              "trigger": "on_skill_disabled",
              "description": "自身技能被摧毁或无效化时，立即摧毁对阵技能（最高话语权）。",
              "operation": {"op":"program","code":["$event.opponent_card","DESTROY"]},
              "authority": "最高话语权",
              "subject": "source"
            },
            {
              "trigger": "on_skill_disabled",
              "description": "自身技能被摧毁或无效化时，减少4环境压制，并使对方获得1劣势次数。",
              "subject": "source",
              "operation": {
                "op": "program",
                "code": [
                  "$self", "环境压制", -4, "STATUS", "$event.target", null, "IS", "NOT",
                  ["$event.target","劣势次数",1,"ABILITY_EFFECT"],
                  "WHEN"
                ]
              }
            },
            {
              "trigger": "AFTER HEAL",
              "description": "自身实际回复生命后，按实回量对全场所有存活角色各造成光点伤害。",
              "when": [{"left":"$event.result","op":"gt","right":0}],
              "operation": {
                "op": "program",
                "code": [
                  "$event.result", "heal", "STORE", "$game.players",
                  ["$event.item.characters"],
                  "MAP", "FLATTEN",
                  ["$event.item.is_alive"],
                  "FILTER",
                  ["$event.target","$local.heal","LIGHTCORE_DAMAGE"],
                  "FOR_EACH_TARGET"
                ]
              },
              "subject": "target",
              "reentrant": true
            },
            {
              "trigger": "AFTER DAMAGE",
              "description": "自身造成百分比伤害后，对目标追加等量光点伤害。",
              "when": [
                {"left":"$event.percentage_damage","op":"eq","right":true},
                {"left":"$event.damage_dealt","op":"eq","right":true}
              ],
              "operation": {"op":"program","code":["$event.target","$event.damage_amount","LIGHTCORE_DAMAGE"]},
              "subject": "source"
            }
          ]
        },
        {
          "name": "天性解放",
          "entries": [
            {
              "trigger": "BEFORE STATUS",
              "description": "解放后，减少环境压制改为获得相应数量的能源。",
              "when": [
                {"left":"$event.status","op":"eq","right":"环境压制"},
                {"left":"$pending.amount","op":"lt","right":0},
                {"left":{"field":"$self.rule_state","key":"天性解放","default":0},"op":"eq","right":true}
              ],
              "operation": {
                "op": "program",
                "code": ["DUP",-1,"MUL","gain","STORE","$self","能源","$local.gain","STATUS",{"op":"cancel"}]
              },
              "subject": "target"
            },
            {
              "trigger": "before_dice_clash",
              "description": "解放后，拼点开始时对对方造成1光点伤害。",
              "when": [{"left":{"field":"$self.rule_state","key":"天性解放","default":0},"op":"eq","right":true}],
              "operation": {"op":"program","code":["$event.target",1,"LIGHTCORE_DAMAGE"]}
            },
            {
              "trigger": "on_clash_lose",
              "description": "解放后，拼点失败时追加1光点伤害。",
              "when": [{"left":{"field":"$self.rule_state","key":"天性解放","default":0},"op":"eq","right":true}],
              "operation": {"op":"program","code":["$event.target",1,"LIGHTCORE_DAMAGE"]}
            }
          ]
        },
        {
          "name": "形态灭杀·回收",
          "entries": [
            {
              "trigger": "on_skill_disabled",
              "description": "形态灭杀在3同调时被摧毁或无效化，收回手牌并立即结束本场交锋。",
              "when": [
                {"left":{"field":"$self.statuses","key":"环境同调","default":0},"op":"ge","right":3},
                {"left":"$event.card.id","op":"eq","right":"liu_annihilate"}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.card", "hand",
                  {"call":"MOVE_CARD","with":{"allow_destroyed":true}},
                  "$game.resolving_duel", "END_DUEL"
                ]
              },
              "subject": "source"
            }
          ]
        }
      ],
      "skills": [
