              }
            }
          ],
          "dice": [
            {
              "type": "slash",
              "level": 4,
              "clash_order": "lower",
              "entries": [
                {
                  "trigger": "on_dice_use",
                  "description": "每层同调降低本骰1级，最多降低2级。",
                  "operation": {
                    "op": "program",
                    "code": ["$event.die","$self","环境同调","STATUS_COUNT",2,"MIN",-1,"MUL","DIE_LEVEL_ADD"]
