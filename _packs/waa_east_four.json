{
  "faction": "WAA东部四科",
  "status_rules": {
    "充能": {
      "polarity": "positive",
      "description": "WAA东部四科的专用蓄能资源，跨回合保留，可按技能或被动消耗。"
    },
    "纯能": {
      "polarity": "positive",
      "description": "高浓度能量状态，可由「纯能电池」安全持有或通过「扩散充能装置」转化扩散。"
    },
    "能源封印": {
      "polarity": "negative",
      "description": "持有能源封印时，无法消耗充能或纯能。充能达到至少8层时解除。"
    }
  },
  "status_entries": {
    "能源封印": [
      {
        "trigger": "BEFORE SPEND_STATUS",
        "subject": "target",
        "when": [{"left": "$event.status", "op": "eq", "right": "充能"}],
        "operation": {"op": "program", "code": ["POP", 0]},
        "description": "持有能源封印时，无法消耗充能。"
      },
      {
        "trigger": "BEFORE SPEND_STATUS",
        "subject": "target",
        "when": [{"left": "$event.status", "op": "eq", "right": "纯能"}],
        "operation": {"op": "program", "code": ["POP", 0]},
        "description": "持有能源封印时，无法消耗纯能。"
      },
      {
        "trigger": "AFTER STATUS",
        "subject": "target",
        "when": [
          {"left": "$event.status", "op": "eq", "right": "充能"},
          {"left": "$event.result", "op": "ge", "right": 8}
        ],
        "operation": {
          "op": "program",
          "code": ["$self", "能源封印", 0, "$self", "能源封印", "STATUS_COUNT", "SUB", "STATUS"]
        },
        "description": "获得充能后，若达到至少8层，解除自身能源封印。"
      }
    ]
  },
  "faction_passives": [
    {
      "name": "WAA东部四科",
      "entries": [
        {
          "trigger": "on_hand_changed",
          "operation": {
            "op": "program",
            "code": [
              "$event.previous_count", 3, "LT", "$event.hand_count", 3, "GE", "AND",
              [
                "$player.characters", ["$event.item.is_alive"], "FILTER",
                ["$event.item", "充能", 1, "STATUS"], "EACH"
              ],
              "WHEN"
            ]
          },
          "description": "当己方手牌数从少于3张达到至少3张时，全体存活友方角色获得1层充能。"
        }
      ]
    }
  ],
