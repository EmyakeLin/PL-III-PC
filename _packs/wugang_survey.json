{
  "faction": "雾港测绘局",
  "characters": [
    {
      "id": "mistport_cen_yao",
      "name": "岑遥",
      "title": "白崖测绘员",
      "rank": "ELITE",
      "max_hp": 9,
      "resource_rules": {"caps": {"校准": 3}},
      "passive_skills": [
        {
          "name": "潮汐手簿",
          "entries": [{
            "trigger": "on_turn_start",
            "operation": {"op": "program", "code": [
              "$player", 1, "DRAW",
              "$self", "校准", "STATUS_COUNT", 0, "EQ", ["$self", "校准", 1, "STATUS"], "WHEN"
            ]},
            "description": "回合开始时额外抽1张手牌。若此时没有校准，获得1层校准。自身最多持有3层校准。"
          }]
        }
      ],
      "skills": [
        {
          "id": "cen_yao_sounding",
          "name": "试水标",
          "cost": 1,
          "range_level": 1,
          "pre_reveal": true,
          "dice": [
            {"type": "pierce", "level": 2, "entries": ["1物理",
              {"trigger": "on_dice_hit", "operation": {"op": "program", "code": ["$self", "校准", 1, "STATUS"]},
               "description": "命中时获得1层校准。"}
            ]},
            {"type": "pierce", "level": 1, "entries": ["1物理"]}
          ]
        },
        {
          "id": "cen_yao_transit",
          "name": "双标成线",
          "cost": 2,
          "range_level": 2,
          "pre_reveal": true,
          "entries": [{
            "trigger": "on_skill_use",
            "operation": {"op": "program", "code": [
              "$self", "校准", 1, "SPEND_STATUS_IN_FULL", ["$card", 2, "SKILL_FINAL_ADD"], "WHEN"
            ]},
            "description": "使用时消耗1层校准，以使本技能最终点数+2。"
          }],
          "dice": [
            {"type": "pierce", "level": 3, "entries": ["1物理"]},
            {"type": "blunt", "level": 2, "entries": ["1物理",
              {"trigger": "on_dice_hit", "operation": {"op": "program", "code": ["$self", "$target", "束缚", 1, "QUEUE_STATUS"]},
               "description": "命中时在下回合对目标施加1层束缚。"}
            ]}
          ]
        },
        {
          "id": "cen_yao_horizon",
          "name": "地平线回声",
          "cost": 4,
          "range_level": 3,
          "pre_reveal": true,
          "entries": [
            {
              "trigger": "on_skill_use",
              "operation": {"op": "program", "code": [
                "$self", "校准", 2, "SPEND_STATUS_IN_FULL", ["$card", "calibrated", 1, "SET_SKILL_STATE"], "WHEN"
              ]},
              "description": "使用时消耗2层校准，以使本技能每颗骰子的伤害+1。"
            },
            {
              "trigger": "before_dice_hit",
              "operation": {"op": "program", "code": [
                "$card", "calibrated", "SKILL_STATE", [{"op": "damage_add", "amount": 1}], "WHEN"
              ]},
              "description": "付足校准时，每颗命中骰各增加1伤害。"
            }
          ],
          "dice": [
            {"type": "pierce", "level": 4, "entries": ["2物理"]},
            {"type": "blunt", "level": 3, "entries": ["1物理"]}
          ]
        },
        {
          "id": "cen_yao_fold_rule",
          "name": "折尺架势",
          "cost": 1,
          "ignore_range": 1,
          "dice": [
            {"type": "block", "level": 3, "entries": [
              {"trigger": "on_clash_win", "operation": {"op": "program", "code": ["$self", "校准", 1, "STATUS"]},
               "description": "拼点胜利时获得1层校准。"}
            ]},
            {"type": "blunt", "level": 2, "entries": ["1物理"]}
          ]
        },
        {
          "id": "cen_yao_reset",
          "name": "收线换尺",
          "cost": 2,
          "entries": [{
            "trigger": "on_skill_use",
            "operation": {"op": "program", "code": ["$self", "校准", 2, "STATUS"]},
            "description": "使用时获得2层校准。"
          }],
          "dice": [
            {"type": "slash", "level": 3, "entries": ["1物理"]},
            {"type": "evade", "level": 2, "entries": [
              {"trigger": "on_clash_win", "operation": {"op": "program", "code": ["$self", "normal", 1, "SHIELD"]},
               "description": "拼点胜利时获得1点护盾。"}
            ]}
          ]
        }
      ]
    }
  ]
}
