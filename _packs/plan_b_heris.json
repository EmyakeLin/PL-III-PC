{
  "faction": "PlanB",
  "characters": [
    {
      "id": "plan_b_heris", "name": "赫里斯", "title": "B级条目",
      "rank": "NORMAL", "max_hp": 6, "base_max_duels": 2,
      "passive_skills": [
        {
          "name": "PlanB 组织",
          "entries": [{
            "trigger": "on_turn_start",
            "description": "【回合开始】若自己的三张技能集满，本回合额外获得1交锋和1通用费。",
            "operation": {
              "op": "program",
              "code": [
                "$self.skills",
                [
                  "$event.item.out_of_combat", "NOT", "$player.cardspace.hand.content", "$event.item",
                  "CONTAINS", "AND"
                ],
                "FILTER", "SIZE", 3, "GE", ["$self",1,"TURN_DUELS_ADD","$player",1,"TURN_COST_ADD"],
                "WHEN"
              ]
            }
          }]
        },
        {
          "name": "B级条目",
          "entries": [{
            "trigger": "on_turn_start",
            "description": "初始交锋上限为2。【回合开始】回复1生命。",
            "operation": "HEAL 1", "target": "self"
          }]
        },
        {
          "name": "火焰之锤",
          "entries": [
            {
              "trigger": "on_turn_start",
              "description": "每回合重新累计火焰之锤的两次触发。",
              "operation": {"op": "program", "code": ["$self", "火焰之锤次数", 0, "SET_CHARACTER_STATE"]}
            },
            {
              "trigger": "before_dice_hit",
              "when": [{"left":"$event.die.type","op":"eq","right":"blunt"}],
              "description": "打击命中前记录目标是否已有烧伤。本回合已触发两次后，目标每8烧伤使这次命中的骰子伤害+1，至多+2。",
              "operation": {
                "op": "program",
                "code": [
                  "$event.die", "命中前持有烧伤", "$event.target", "烧伤", "STATUS_COUNT", 0, "GT",
                  "SET_DIE_STATE", "$self.rule_state", "火焰之锤次数", 0, "LOOKUP", 2, "GE",
                  "$event.die.has_damage_part", "AND",
                  [
                    "$event.target", "烧伤", "STATUS_COUNT", 8, "FLOOR_DIV", 2, "MIN", "amount", "STORE",
                    "$event.target", "$event.hit_modifiers", "damage_add", "$local.amount", "normal",
                    "ADD_DAMAGE_MODIFIER"
                  ],
                  "WHEN"
                ]
              }
            },
            {
              "trigger": "on_dice_hit", "when": [{"left":"$event.die.type","op":"eq","right":"blunt"}],
              "description": "【命中时】打击命中原本带有烧伤的目标时，施加1烧伤，每回合2次。",
              "operation": {
                "op": "program",
                "code": [
                  "$event.die.use_state", "命中前持有烧伤", false, "LOOKUP", "$self.rule_state", "火焰之锤次数", 0,
                  "LOOKUP", 2, "LT", "AND",
                  [
                    "$self", "火焰之锤次数", "$self.rule_state", "火焰之锤次数", 0, "LOOKUP", 1, "ADD",
                    "SET_CHARACTER_STATE", "$event.target", "烧伤", 1, "STATUS"
                  ],
                  "WHEN"
                ]
              }
            }
          ]
        },
        {
          "name": "爆燃清算",
          "entries": [{
            "trigger": "AFTER ACTIVATE_STATUS", "subject": "ally",
            "when": [
              {"left":"$event.status","op":"eq","right":"烧伤"},
              {"left":"$event.activation_kind","op":"eq","right":"ignite"},
              {"left":"$event.result","op":"eq","right":true}
            ],
            "description": "其他友方角色的攻击触发引燃时，对同一目标发起一次「重锤！」追击。调用技能副本，减免1费，【使用时】照常结算。每位队友每回合至多触发一次。",
            "operation": {
              "op": "program",
              "code": [
                "$event.activation_owner", "CHARACTER_OF", "ally", "STORE", "$event.activation_origin",
                "die", "EQ", "$event.activation_origin", "card", "EQ", "OR", {"local":"ally"}, "$self",
                "EQ", "NOT", "AND", "$game.resolving_duel", null, "IS", "NOT", "AND",
                "$event.target.is_alive", "AND", "$self.rule_state", {"local":"ally"}, 0, "LOOKUP",
                "$game.turn_number", "EQ", "NOT", "AND",
                [
                  "$self", {"local":"ally"}, "$game.turn_number", "SET_CHARACTER_STATE", "$self",
                  "$self.skills", ["$event.item.id","heris_heavy_hammer","EQ"], "FILTER", "FIRST",
                  {"field":"printed_data","default":null}, "SKILL_COPY", 1, "SKILL_USE", "$event.target",
                  "immediate_attack", "INSERT_AT", "INSERT_SKILL"
                ],
                "WHEN"
              ]
            }
          }]
        },
        {
          "name": "能源聚集",
          "entries": [{
            "trigger": "on_status_changed", "subject": "target", "when": [{"left":"$event.status","op":"eq","right":"能源"}],
            "description": "每累计实际消耗8能源，获得1凝聚。余数跨回合保留。",
            "operation": {
              "op": "program",
              "code": [
                "$event.actual_delta", 0, "LT",
                [
                  "$self.rule_state", "能源消耗余量", 0, "LOOKUP", "$event.actual_delta", "SUB", "total",
                  "STORE", "DIVMOD $local.total 8", "remainder", "STORE", "earned", "STORE", "$self",
                  "能源消耗余量", "$local.remainder", "SET_CHARACTER_STATE", {"local":"earned"}, 0, "GT",
                  ["$self","凝聚",{"local":"earned"},"STATUS"], "WHEN"
                ],
                "WHEN"
              ]
            }
          }]
        }
      ],
      "skills": [
        {
          "id": "heris_heavy_hammer", "name": "重锤！", "cost": 1,
          "entries": [{
            "trigger": "on_skill_use",
            "description": "【使用时】消耗2能源。",
            "operation": {
              "op": "program",
              "code": ["$self","能源",2,{"call":"SPEND_STATUS","result":"result","default":0},"POP"]
            }
          }],
          "dice": [
            {"type": "blunt", "level": 3, "entries": [
              "1物理",
              {"trigger": "on_dice_hit", "description": "【命中时】施加1烧伤，凝聚至少3层时引燃。",
               "operation": {
                 "op": "program",
                 "code": [
                   "$event.target", "烧伤", 1, "STATUS", "$self", "凝聚", "STATUS_COUNT", 3, "GE",
                   [{"keyword":"ignite"}], "WHEN"
                 ]
               }}
            ]}
          ]
        },
        {
          "id": "heris_flame_conversion", "name": "烈火化能", "cost": 2,
          "entries": [
            {"trigger": "on_skill_use", "description": "【使用时】若自身能源不高于4层，则获得2能源。",
             "operation": {"op": "program", "code": [
               "$self", "能源", "STATUS_COUNT", 4, "LE", ["$self", "能源", 2, "STATUS"], "WHEN"
             ]}},
            {
              "trigger": "on_skill_use",
              "description": "【使用时】目标每有4烧伤，自身获得1能源，至多4层。",
              "operation": {
                "op": "program",
                "code": [
                  "$event.target", "DUP", "NOT", ["POP","$event.card","SELECT_SKILL_TARGET"], "WHEN",
                  "skill_recipient", "STORE", "$local.skill_recipient",
                  [
                    "$local.skill_recipient", "烧伤", "STATUS_COUNT", 4, "FLOOR_DIV", 4, "MIN", "energy",
                    "STORE", {"local":"energy"}, 0, "GT", ["$self","能源",{"local":"energy"},"STATUS"],
                    "WHEN"
                  ],
                  "WHEN"
                ]
              }
            }
          ],
          "dice": [
            {"type": "blunt", "level": 1, "entries": [
              {"trigger": "on_dice_hit", "description": "【命中时】获得1能源，施加1烧伤。",
               "operation": ["STATUS 能源 1 $self","STATUS 烧伤 1 $event.target"]}
            ]},
            {"type": "blunt", "level": 2, "entries": [
              {"trigger": "on_dice_hit", "when": [{"left": {"field": "$event.target.statuses", "key": "烧伤", "default": 0}, "op": "ge", "right": 8}],
               "description": "【命中时】若目标烧伤至少8层，获得2能源并抽1张牌。",
               "operation": ["STATUS 能源 2 $self", "DRAW 1"]}
            ]}
          ]
        },
        {
          "id": "heris_crush", "name": "击溃！", "cost": 3,
          "ignore_range_amount": {
            "value": {
              "if": {
                "left": {
                  "if": "$event.card.use_effects_resolved",
                  "then": {"field": "$event.card.use_state", "key": "使用时凝聚", "default": 0},
                  "else": {"field": "$self.statuses", "key": "凝聚", "default": 0}
                },
                "op": "ge", "right": 2
              },
              "then": 2, "else": 0
            },
            "description": "使用前按当前凝聚判断射程。使用时凝聚至少2层，本技能无视2级远程。"
          },
          "entries": [
            {"trigger": "on_skill_use",
             "description": "【使用时】消耗全部能源。每消耗4层，本技能骰级+1。每消耗2层，首骰命中时额外施加1烧伤。",
             "operation": {
               "op": "program",
               "code": [
                 "$self", "能源", "all", {"call":"SPEND_STATUS","result":"result","default":0}, "paid",
                 "STORE", "$event.card", {"local":"paid"}, 4, "FLOOR_DIV", "SKILL_LEVEL_ADD",
                 "$event.card", "首骰额外烧伤", {"local":"paid"}, 2, "FLOOR_DIV", "SET_SKILL_STATE"
               ]
             }},
            {"trigger": "on_skill_use",
             "description": "【使用时】凝聚至少1层则本技能骰子基础值+2，至少2层无视2级远程，至少3层令首骰驻留。首骰拼输仍可命中，跳过伤害部分。",
             "operation": {"op": "program", "code": [
               "$event.card", "使用时凝聚", "$self", "凝聚", "STATUS_COUNT", "SET_SKILL_STATE"
             ]}},
            {"trigger": "before_dice_use",
             "description": "若使用时凝聚至少1层，本骰基础值+2。",
             "operation": {
               "op": "program",
               "code": ["$event.card.use_state","使用时凝聚",0,"LOOKUP",1,"GE",["$event.die",2,"DIE_BASE_ADD"],"WHEN"]
             }}
          ],
          "dice": [
            {"type": "blunt", "level": 3, "entries": [
              "2物理",
              {
                "trigger": "on_clash_lose",
                "description": "【拼点失败】驻留时拼输仍可命中，跳过伤害部分。",
                "operation": {
                  "op": "program",
                  "code": [
                    "$event.card.use_state", "使用时凝聚", 0, "LOOKUP", 3, "GE",
                    ["$event.die","effects_only",null,"QUEUE_HIT"], "WHEN"
                  ]
                }
              },
              {"trigger": "on_dice_hit", "description": "【命中时】施加2烧伤及使用时取得的额外烧伤，然后引燃。",
               "operation": {
                 "op": "program",
                 "code": [
                   "$event.target", "烧伤", 2, "$event.card.use_state", "首骰额外烧伤", 0, "LOOKUP", "ADD",
                   "STATUS", {"keyword":"ignite"}
                 ]
               }},
              {
                "trigger": "AFTER STATUS",
                "subject": "source",
                "when": [
                  {"left":"$event.status","op":"eq","right":"烧伤"},
                  {"left":"$event.activation_kind","op":"eq","right":"ignite"},
                  {"left":"$event.issuer","op":"eq","right":"$event.activation_entry"}
                ],
                "description": "本骰引燃每实际移除1烧伤，自身获得1能源。",
                "operation": {
                  "op": "program",
                  "code": [
                    "$event.activation_owner", "$owner", "EQ", "$event.actual_delta", 0, "LT", "AND",
                    ["$self","能源",0,"$event.actual_delta","SUB","STATUS"], "WHEN"
                  ]
                }
              }
            ]},
            {"type": "blunt", "level": 4, "entries": [
              "1物理",
              {"trigger": "on_dice_hit", "description": "【命中时】触发引燃。", "operation": {"keyword":"ignite"}},
              {
                "trigger": "AFTER STATUS",
                "subject": "source",
                "when": [
                  {"left":"$event.status","op":"eq","right":"烧伤"},
                  {"left":"$event.activation_kind","op":"eq","right":"ignite"},
                  {"left":"$event.issuer","op":"eq","right":"$event.activation_entry"}
                ],
                "description": "本骰引燃每实际移除2烧伤，全体友方各获得1能源。",
                "operation": {
                  "op": "program",
                  "code": [
                    "$event.activation_owner", "$owner", "EQ", "$event.actual_delta", 0, "LT", "AND",
                    [
                      0, "$event.actual_delta", "SUB", 2, "FLOOR_DIV", "energy", "STORE",
                      {"local":"energy"}, 0, "GT",
                      [
                        "$player.characters",
                        ["$event.item.is_alive",["$event.item","能源",{"local":"energy"},"STATUS"],"WHEN"],
                        "EACH"
                      ],
                      "WHEN"
                    ],
                    "WHEN"
                  ]
                }
              }
            ]},
            {"type": "blunt", "level": 1, "multiplier": 2, "entries": [
              {"trigger": "on_dice_hit", "description": "【命中时】触发引燃。", "operation": {"keyword":"ignite"}},
              {
                "trigger": "AFTER STATUS",
                "subject": "source",
                "when": [
                  {"left":"$event.status","op":"eq","right":"烧伤"},
                  {"left":"$event.activation_kind","op":"eq","right":"ignite"},
                  {"left":"$event.issuer","op":"eq","right":"$event.activation_entry"}
                ],
                "description": "本骰引燃每实际移除3烧伤，下回合施加1虚弱和1束缚。",
                "operation": {
                  "op": "program",
                  "code": [
                    "$event.activation_owner", "$owner", "EQ", "$event.actual_delta", 0, "LT", "AND",
                    [
                      0, "$event.actual_delta", "SUB", 3, "FLOOR_DIV", "stacks", "STORE",
                      {"local":"stacks"}, 0, "GT",
                      [
                        {
                          "schedule": {
                            "event": "on_turn_prepared",
                            "source": "$self",
                            "target": "$event.target",
                            "after_turns": 1,
                            "through_turns": 1,
                            "uses": 1,
                            "require_source_alive": false,
                            "require_target_alive": true,
                            "capture": {"stacks":"$local.stacks"},
                            "then": [
                              "$event.scheduled.target", "虚弱", "$event.scheduled.capture.stacks",
                              "STATUS", "$event.scheduled.target", "束缚",
                              "$event.scheduled.capture.stacks", "STATUS"
                            ]
                          }
                        }
                      ],
                      "WHEN"
                    ],
                    "WHEN"
                  ]
                }
              }
            ]}
          ]
        }
      ]
    }
  ]
}
