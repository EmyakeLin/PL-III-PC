{
  "faction": "铁契军团",
  "characters": [
    {
      "id": "iron_qi_zheng", "name": "祁铮", "title": "铁契军团·先登官",
      "rank": "EMPOWERED_BOSS", "max_hp": 18, "base_max_duels": 4,
      "passive_skills": [
        {
          "name": "先登",
          "entries": [
            {
              "trigger": "on_turn_start",
              "description": "回合开始时，额外抽1张手牌并获得1通用费。",
              "operation": {"op": "program", "code": ["$player", 1, "DRAW", "$player", 1, "TURN_COST_ADD"]}
            },
            {
              "trigger": "on_dice_hit",
              "description": "每回合首次以进攻骰拼点胜利并命中时，对目标额外施加3裂血。",
              "operation": {"op": "program", "code": [
                "$is_attack", "$clash_result", "win", "EQ", "AND",
                "$self", "先登触发回合", "CHARACTER_STATE", "$turn_number", "EQ", "NOT", "AND",
                ["$self", "先登触发回合", "$turn_number", "SET_CHARACTER_STATE", "$target", "裂血", 3, "STATUS"], "WHEN"
              ]}
            }
          ]
        },
        {
          "name": "沿创进刀",
          "entries": [
            {
              "trigger": "on_skill_use",
              "description": "结算技能自身的【使用时】后，主目标每有3裂血，本技能骰子等级+1、最终点数+2，至多两档。",
              "operation": {"op": "program", "code": [
                "$skill_target", "裂血", "STATUS_COUNT", 3, "FLOOR_DIV", 2, "MIN", "bands", "STORE",
                "$card", {"local": "bands"}, "SKILL_LEVEL_ADD",
                "$card", {"local": "bands"}, 2, "MUL", "SKILL_FINAL_ADD"
              ]}
            },
            {
              "trigger": "on_clash_lose",
              "description": "每次使用技能期间，首次以进攻骰对至少3裂血的目标拼输时，该骰驻留，仍然命中，仅结算伤害部分。",
              "operation": {"op": "program", "code": [
                "$is_attack", "$target", "裂血", "STATUS_COUNT", 3, "GE", "AND",
                "$card", "已驻留", "SKILL_STATE", "NOT", "AND",
                ["$card", "已驻留", 1, "SET_SKILL_STATE", "$die", "damage_only", "QUEUE_HIT"], "WHEN"
              ]}
            },
            {
              "trigger": "before_dice_hit", "when": {"hit_mode": "damage_only"},
              "description": "驻留骰拼输造成的这次命中，伤害−1。",
              "operation": {"op": "damage_add", "amount": -1, "grade": "concept"}
            }
          ]
        },
        {
          "name": "过身取背",
          "entries": [
            {
              "trigger": "before_dice_hit",
              "description": "每回合一次。带有伤害部分的进攻骰即将命中处于裂血爆发的目标时，立即以「过身」副本对同一目标发起单方面攻击，减免1费。随后继续原来的命中。",
              "operation": {"op": "program", "code": [
                "$is_attack", "$has_damage_part", "AND", "$target", "裂血", "STATUS_ACTIVE", "AND",
                "$self", "过身取背触发回合", "CHARACTER_STATE", "$turn_number", "EQ", "NOT", "AND",
                [
                  "$self", "过身取背触发回合", "$turn_number", "SET_CHARACTER_STATE",
                  "$self", "qi_zheng_pass", "COPY_SKILL", 1, "SKILL_USE",
                  "$target", "immediate_attack", "INSERT_AT", "INSERT_SKILL"
                ], "WHEN"
              ]}
            }
          ]
        }
      ],
      "skills": [
        {
          "id": "qi_zheng_open", "name": "开锋", "cost": 1,
          "entries": [
            {"trigger": "on_skill_use", "description": "使用时对主目标施加2裂血。",
             "operation": {"op": "program", "code": ["$skill_target", "裂血", 2, "STATUS"]}}
          ],
          "dice": [
            {"type": "slash", "level": 3, "entries": ["1物理",
              {"trigger": "on_dice_hit", "description": "命中时施加2裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 2, "STATUS"]}}]},
            {"type": "pierce", "level": 2, "entries": ["1穿甲"]}
          ]
        },
        {
          "id": "qi_zheng_pass", "name": "过身", "cost": 1,
          "dice": [
            {"type": "slash", "level": 4, "entries": ["2穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加2裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 2, "STATUS"]}}]}
          ]
        },
        {
          "id": "qi_zheng_guard", "name": "抵刀", "cost": 1,
          "entries": [
            {"trigger": "on_skill_use", "description": "使用时获得2强化护盾。",
             "operation": {"op": "program", "code": ["$self", "reinforced", 2, "SHIELD"]}}
          ],
          "dice": [
            {"type": "block", "level": 4, "entries": [
              {"trigger": "on_clash_win", "description": "反震2。招架拼赢时对目标造成2普通伤害。",
               "operation": {"op": "program", "code": ["$target", 2, "normal", "none", "DAMAGE"]}}]},
            {"type": "slash", "level": 3, "entries": ["2物理"]}
          ]
        },
        {
          "id": "qi_zheng_hook", "name": "勾带", "cost": 2,
          "entries": [
            {"trigger": "on_skill_use", "description": "使用时对主目标施加3裂血。",
             "operation": {"op": "program", "code": ["$skill_target", "裂血", 3, "STATUS"]}}
          ],
          "dice": [
            {"type": "pierce", "level": 3, "entries": ["2穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加2裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 2, "STATUS"]}}]},
            {"type": "slash", "level": 3, "entries": ["1物理",
              {"trigger": "on_dice_hit", "description": "命中时抽1张手牌。",
               "operation": {"op": "program", "code": ["$player", 1, "DRAW"]}}]}
          ]
        },
        {
          "id": "qi_zheng_draw", "name": "抽刀", "cost": 2, "pre_reveal": true,
          "dice": [
            {"type": "slash", "level": 4, "entries": ["2穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加1裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 1, "STATUS"]}}]},
            {"type": "slash", "level": 3, "entries": ["2物理"]}
          ]
        },
        {
          "id": "qi_zheng_volley", "name": "压阵射击", "cost": 2, "range_level": 2,
          "dice": [
            {"type": "pierce", "level": 3, "entries": ["2穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加2裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 2, "STATUS"]}}]},
            {"type": "pierce", "level": 3, "entries": ["1穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加1裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 1, "STATUS"]}}]}
          ]
        },
        {
          "id": "qi_zheng_counter", "name": "折锋", "cost": 3,
          "dice": [
            {"type": "block", "level": 5, "entries": [
              {"trigger": "on_clash_win", "description": "反震3。招架拼赢时对目标造成3普通伤害。",
               "operation": {"op": "program", "code": ["$target", 3, "normal", "none", "DAMAGE"]}}]},
            {"type": "slash", "level": 4, "entries": ["3穿甲"]},
            {"type": "slash", "level": 3, "entries": ["2物理",
              {"trigger": "on_dice_hit", "description": "命中时施加2裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 2, "STATUS"]}}]}
          ]
        },
        {
          "id": "qi_zheng_sweep", "name": "横断", "cost": 3,
          "dice": [
            {"type": "slash", "level": 4, "entries": [
              {"trigger": "AFTER RESOLVE_HIT", "when": {"result": true}, "description": "群伤2物理。",
               "operation": {"op": "program", "damage_part": true, "code": [
                 "$enemies", ["$target", 2, "normal", "slash", "DAMAGE"], "FOR_EACH_TARGET"
               ]}},
              {"trigger": "on_dice_hit", "description": "命中时对全体敌方施加2裂血。",
               "operation": {"op": "program", "code": ["$enemies", ["$target", "裂血", 2, "STATUS"], "FOR_EACH_TARGET"]}}
            ]},
            {"type": "slash", "level": 3, "entries": ["3穿甲"]}
          ]
        },
        {
          "id": "qi_zheng_advance", "name": "踏阵", "cost": 3,
          "dice": [
            {"type": "pierce", "level": 4, "entries": ["2穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加3裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 3, "STATUS"]}}]},
            {"type": "slash", "level": 3, "entries": ["2物理",
              {"trigger": "on_dice_use", "description": "本骰额外使用一次。",
               "operation": {"op": "program", "code": ["$is_repeat", "NOT", ["$die", "REPEAT_DIE"], "WHEN"]}}]}
          ]
        },
        {
          "id": "qi_zheng_line", "name": "斩列", "cost": 4,
          "entries": [
            {"trigger": "on_skill_use", "description": "使用时对主目标施加3裂血。",
             "operation": {"op": "program", "code": ["$skill_target", "裂血", 3, "STATUS"]}}
          ],
          "dice": [
            {"type": "slash", "level": 4, "entries": [
              {"trigger": "AFTER RESOLVE_HIT", "when": {"result": true}, "description": "群伤3物理。",
               "operation": {"op": "program", "damage_part": true, "code": [
                 "$enemies", ["$target", 3, "normal", "slash", "DAMAGE"], "FOR_EACH_TARGET"
               ]}}
            ]},
            {"type": "slash", "level": 4, "entries": ["3超穿甲",
              {"trigger": "on_dice_hit", "description": "命中时施加2裂血。",
               "operation": {"op": "program", "code": ["$target", "裂血", 2, "STATUS"]}}]}
          ]
        },
        {
          "id": "qi_zheng_end", "name": "刀过无声", "cost": 5,
          "entries": [
            {"trigger": "on_skill_use", "description": "使用时若主目标已有至少6裂血，首骰额外使用两次。",
             "operation": {"op": "program", "code": [
               "$skill_target", "裂血", "STATUS_COUNT", 6, "GE",
               ["$card", "首骰剩余重复", 2, "SET_SKILL_STATE"], "WHEN"
             ]}}
          ],
          "dice": [
            {"type": "slash", "level": 4, "entries": ["3超穿甲",
              {"trigger": "on_dice_use", "description": "本技能已取得首骰重复次数时，每次用骰消耗一次次数并重复使用。",
               "operation": {"op": "program", "code": [
                 "$card", "首骰剩余重复", "SKILL_STATE", "remaining", "STORE",
                 {"local": "remaining"}, 0, "GT",
                 ["$card", "首骰剩余重复", {"local": "remaining"}, 1, "SUB", "SET_SKILL_STATE", "$die", "REPEAT_DIE"], "WHEN"
               ]}}]},
            {"type": "pierce", "level": 3, "entries": ["3穿甲"]}
          ]
        }
      ]
    }
  ]
