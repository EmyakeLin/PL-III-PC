{
  "faction": "PlanB",
  "turn_end_statuses": ["骰级免疫"],
  "status_entries": {
    "涡流": [
      {
        "trigger": "BEFORE RESOLVE_CLASH_SCORE",
        "operation": {"op": "program", "code": [
          "$value_ref", "$self", "涡流", "STATUS_COUNT", 10, "MIN", "VALUE_FLOOR"
        ]},
        "description": "自身拼点点数至少为当前涡流层数，保底最多计入10点。"
      },
      {
        "trigger": "on_turn_end",
        "operation": {"op": "program", "code": [
          "$self", "涡流", 2, "SPEND_STATUS", "POP",
          "$self", "$self", "骰子等级降低", 1, "QUEUE_STATUS"
        ]},
        "description": "回合结束时消耗2层涡流，并在下回合获得1层骰子等级降低。"
      }
    ],
    "骰级免疫": [
      {
        "trigger": "BEFORE RESOLVE_DIE_LEVEL",
        "operation": {"op": "program", "code": [
          "$value_ref", "$printed_level", "VALUE_FLOOR", "$value_ref", "$printed_level", "VALUE_CEILING"
        ]},
        "description": "本回合自身按印刷骰级使用骰子。"
      }
    ]
  },
  "characters": [
    {
      "id": "plan_b_annolin",
      "name": "安诺琳",
