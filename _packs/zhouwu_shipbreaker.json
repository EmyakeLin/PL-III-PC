            "$target_alive", [
              "$target", "粉线", 1, "SPEND_STATUS_IN_FULL", ["$target", 2, "LIGHTCORE_DAMAGE", "$self", "normal", 1, "SHIELD"], "WHEN"
            ], "WHEN"
          ]},
          "description": "自身骰面的每段直伤造成至少1点伤害后，若目标存活，消耗其1粉线以追加2光点伤害并获得1普通护盾。粉线记录在被标记的角色上，跨回合保留。"
        }]
      }
    ],
    "skills": [
      {
        "id": "shipbreaker_chalk", "name": "弹粉线", "cost": 1,
