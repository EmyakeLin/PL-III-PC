      "passive_skills": [
        {
          "name": "S级条目",
          "entries": [
            {
              "trigger": "on_turn_start",
              "operation": {
                "op": "program",
                "code": ["$player", 2, "TURN_COST_ADD", "$player", 1, "DRAW", "$self", 2, "HEAL"]
              },
              "description": "每回合费用上限+2，回合开始时额外抽1张手牌并回复2生命。"
            }
          ]
        },
        {
          "name": "Plan B",
          "entries": [
            {
              "trigger": "on_turn_start",
              "operation": {
                "op": "program",
                "code": [
                  "$hand_count", 5, "GE", ["$self", 1, "TURN_DUELS_ADD", "$player", 1, "TURN_COST_ADD"], "WHEN"
                ]
              },
              "description": "回合开始额外抽牌后，手牌达到5张则本回合增加1交锋、1通用费用。"
            }
          ]
        },
        {
          "name": "焦黄风暴",
          "entries": [
            {
              "trigger": "BEFORE FINALIZE_DAMAGE",
              "subject": "source",
              "when": {"damage_part": true, "clash_result": "win", "damage_amount": 0},
              "operation": {
                "op": "program",
                "code": [
                  "$damage_die_is_attack", "$damage_die", "zero_burst_replacement", "DIE_STATE", "NOT", "AND",
                  ["$value_ref", 0, "VALUE_CEILING"], "WHEN"
                ]
              },
              "description": "进攻骰拼点胜利，即将造成0点的直伤部分固定为0。"
            },
            {
              "trigger": "AFTER DAMAGE",
              "subject": "source",
              "when": {"damage_part": true, "clash_result": "win", "damage_amount": 0, "damage_dealt": true},
              "operation": {
                "op": "program",
                "code": [
                  "$damage_die_is_attack", "$damage_die", "zero_burst_replacement", "DIE_STATE", "NOT", "AND",
                  ["$target", "崩析", 1, "STATUS"], "WHEN"
                ]
              },
              "description": "上述0直伤成功结算后视为造成伤害，对该段目标施加1崩析。"
            },
            {
              "trigger": "AFTER DAMAGE",
              "subject": "any",
              "when": {"damage_cause": "崩析爆发"},
              "operation": {
                "op": "program",
                "code": ["$self", "$damage_amount", 2, "FLOOR_DIV", "HEAL"]
              },
              "description": "场上任何角色发生崩析爆发时，回复爆发伤害量一半的生命，向下取整。"
            },
            {
              "trigger": "BEFORE ACTIVATE_STATUS",
              "subject": "target",
              "when": {"status": "崩析"},
              "operation": {
                "op": "program",
                "code": [
                  "$in_turn_end", "NOT",
                  [
                    {"op": "cancel"}
                  ],
                  "WHEN"
                ]
              },
              "description": "自身在回合结束前不会触发崩析爆发。"
            },
            {
              "trigger": "before_turn_end",
              "when": {"owner_status_at_least": {"崩析": 8}},
              "operation": {
                "op": "program",
                "code": ["$self", "崩析", "ACTIVATE_STATUS", "POP"]
              },
              "description": "进入回合末时，若自身仍至少有8崩析，立即尝试爆发。"
            }
          ]
        },
        {
          "name": "弥合裂隙",
          "entries": [
            {
              "trigger": "on_turn_start",
              "when": {"owner_status_at_least": {"崩析": 4}},
              "operation": {
                "op": "program",
                "code": ["$self", "弥合", 1, "STATUS", "$self", "虚弱", -2, "STATUS"]
              },
              "description": "回合开始，自身崩析不低于4时，获得1弥合并减少2虚弱。"
            }
          ]
        },
        {
          "name": "狂暴毁灭",
          "entries": [
            {
              "trigger": "after_dice_use",
              "operation": {
                "op": "program",
                "code": [
                  "$is_attack", "$did_deal_damage", "NOT", "AND", "$target_alive", "AND",
                  [
                    "$self", "崩析", "STATUS_COUNT", 6, "GE",
                    [{"op": "damage", "amount": 2, "grade": "pierce", "from_die": true}],
                    [{"op": "damage", "amount": 1, "grade": "pierce", "from_die": true}], "IF_ELSE"
                  ],
                  "WHEN"
                ]
              },
              "description": "进攻骰使用后，若本骰未成功造成任何直伤，则对目标造成1穿甲；自身崩析不低于6则改为2穿甲。此追伤仍受远程压制。"
            }
          ]
        },
        {
          "name": "崩析灭除",
          "entries": [
            {
              "trigger": "AFTER ACTIVATE_STATUS",
              "subject": "any",
              "when": {"status": "崩析", "result": true},
              "operation": {
                "op": "program",
                "code": [
                  "$die_owner", "$self", "EQ",
                  [
                    "$is_attack", ["$die", "burst_during_attack", true, "SET_DIE_STATE"], "WHEN"
                  ],
                  "WHEN"
                ]
              },
              "description": "在骰子的攻击期间记录场上发生的崩析爆发。"
            },
            {
              "trigger": "after_dice_use",
              "operation": {
                "op": "program",
                "code": [
                  "$is_attack", "$die", "burst_during_attack", "DIE_STATE", "AND", "$target_alive", "AND",
                  ["$self", "$target", "崩离", 1, "QUEUE_STATUS"], "WHEN"
                ]
              },
              "description": "自身这颗进攻骰攻击期间发生过崩析爆发时，下回合对本骰目标施加1崩离。"
            }
          ]
        }
      ],
