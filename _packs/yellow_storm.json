{
  "faction": "PlanB",
  "turn_end_statuses": ["崩裂", "弥合"],
  "status_rules": {
    "崩析": {
      "polarity": "negative",
      "description": "每3层使进攻骰的直伤部分减1。达到8层时爆发，受到初始生命上限三分之一（向上取整）的超穿甲伤害后移除。受到直伤时下回合获得1虚弱；骰子造成至少1点直伤时传播1崩析，每骰一次。目标已有崩析则立即施加，否则在下回合施加。",
      "activation": {
        "label": "崩析爆发",
        "remove_after": true,
        "operation": {
          "op": "program",
          "code": ["$self", "$self.original_max_hp", 2, "ADD", 3, "FLOOR_DIV", "concept", "none", "DAMAGE"]
        }
      }
    },
    "崩裂": {
      "polarity": "negative",
      "description": "本回合受到的崩析爆发伤害+X。至少2层时，每次被施加崩析额外增加1层。回合结束时，崩析+X，随后解除。"
    },
    "弥合": {
      "polarity": "positive",
      "description": "本回合受到的崩析爆发伤害−X。至少2层时，每次被施加崩析减少1层。回合结束时，崩析−X，随后解除。"
    },
    "崩离": {
      "polarity": "negative",
      "permanent": true,
      "max_hp_per_stack": -1,
      "description": "生命上限减少X，无法解除。"
    }
  },
  "status_entries": {
    "崩析": [
      {
        "trigger": "AFTER STATUS",
        "when": [
          {"left": "$event.status", "op": "eq", "right": "崩析"},
          {"left": "$event.result", "op": "ge", "right": 8},
          {"left": "$event.actual_delta", "op": "gt", "right": 0}
        ],
        "operation": {"op": "program", "code": ["$self", "崩析", "ACTIVATE_STATUS"]},
        "description": "崩析达到8层时立即爆发。"
      },
      {
        "trigger": "BEFORE RESOLVE_DAMAGE",
        "subject": "source",
        "when": [{"left": "$event.damage_part", "op": "eq", "right": true}],
        "operation": {
          "op": "program",
          "code": ["$event.damage_die.is_attack", ["$self", "崩析", "STATUS_COUNT", 3, "FLOOR_DIV", "SUB"], "WHEN"]
        },
        "description": "每3层崩析使自身进攻骰的直伤部分减1。"
      },
      {
        "trigger": "AFTER DAMAGE",
        "subject": "target",
        "when": [{"left": "$event.damage_received", "op": "eq", "right": true}],
        "operation": {
          "schedule": {
            "event": "on_turn_prepared",
            "source": "$self",
            "target": "$self",
            "after_turns": 1,
            "through_turns": 1,
            "uses": 1,
            "require_source_alive": false,
            "require_target_alive": true,
            "then": ["$event.scheduled.target", "虚弱", 1, "STATUS"]
          }
        },
        "description": "受到直伤时下回合获得1层虚弱。"
      },
      {
        "trigger": "AFTER DAMAGE",
        "subject": "source",
        "when": [{"left": "$event.damage_amount", "op": "ge", "right": 1}],
        "operation": {
          "op": "program",
          "code": [
            "$event.damage_die",
            [
              "$event.damage_die.use_state", "collapse_spread", false, "LOOKUP", "NOT",
              [
                "$event.damage_die", "collapse_spread", true, "SET_DIE_STATE",
                "$event.target", "崩析", "STATUS_COUNT", 0, "GT",
                ["$event.target", "崩析", 1, "STATUS"],
                [
                  {
                    "schedule": {
                      "event": "on_turn_prepared",
                      "source": "$self",
                      "target": "$event.target",
                      "after_turns": 1,
                      "through_turns": 1,
                      "uses": 1,
                      "require_source_alive": false,
                      "require_target_alive": true,
                      "then": ["$event.scheduled.target", "崩析", 1, "STATUS"]
                    }
                  }
                ],
                "IF_ELSE"
              ],
              "WHEN"
            ],
            "WHEN"
          ]
        },
        "description": "骰子造成至少1点直伤时传播1层崩析，每骰一次。"
      }
    ],
    "崩裂": [
      {
        "trigger": "BEFORE RESOLVE_DAMAGE",
        "subject": "target",
        "when": [{"left": "$event.damage_cause", "op": "eq", "right": "崩析爆发"}],
        "operation": {"op": "program", "code": ["$self", "崩裂", "STATUS_COUNT", "ADD"]},
        "description": "本回合受到的崩析爆发伤害增加等同于崩裂层数。"
      },
      {
        "trigger": "BEFORE STATUS",
        "subject": "target",
        "when": [
          {"left": "$event.status", "op": "eq", "right": "崩析"},
          {"left": {"field": "$self.statuses", "key": "崩裂", "default": 0}, "op": "ge", "right": 2},
          {"left": "$pending.amount", "op": "gt", "right": 0}
        ],
        "operation": {"op": "program", "code": [1, "ADD"]},
        "description": "至少持有2层崩裂时，每次被施加崩析额外增加1层。"
      },
      {
        "trigger": "before_turn_end",
        "operation": {
          "op": "program",
          "code": ["$self", "崩析", "$self", "崩裂", "STATUS_COUNT", "STATUS", "$self", "崩裂", "all", "SPEND_STATUS"]
        },
        "description": "【回合结束】崩析增加等同于崩裂层数，随后解除崩裂。"
      }
    ],
    "弥合": [
      {
        "trigger": "BEFORE RESOLVE_DAMAGE",
        "subject": "target",
        "when": [{"left": "$event.damage_cause", "op": "eq", "right": "崩析爆发"}],
        "operation": {"op": "program", "code": ["$self", "弥合", "STATUS_COUNT", "SUB"]},
        "description": "本回合受到的崩析爆发伤害减少等同于弥合层数。"
      },
      {
        "trigger": "BEFORE STATUS",
        "subject": "target",
        "when": [
          {"left": "$event.status", "op": "eq", "right": "崩析"},
          {"left": {"field": "$self.statuses", "key": "弥合", "default": 0}, "op": "ge", "right": 2},
          {"left": "$pending.amount", "op": "gt", "right": 0}
        ],
        "operation": {"op": "program", "code": [1, "SUB"]},
        "description": "至少持有2层弥合时，每次被施加崩析减少1层。"
      },
      {
        "trigger": "before_turn_end",
        "operation": {
          "op": "program",
          "code": [
            "$self", "崩析", "$self", "弥合", "STATUS_COUNT", -1, "MUL", "STATUS", "$self", "弥合", "all", "SPEND_STATUS"
          ]
        },
        "description": "【回合结束】崩析减少等同于弥合层数，随后解除弥合。"
      }
    ]
  },
  "characters": [
    {
      "id": "plan_b_sa",
      "name": "萨",
      "title": "焦黄风暴",
      "rank": "BOSS",
      "max_hp": 15,
      "passive_skills": [
        {
          "name": "S级条目",
          "entries": [
            {
              "trigger": "on_turn_start",
              "operation": {
                "op": "program",
                "code": ["$player", 2, "TURN_COST_ADD", "DRAW 1", "HEAL 2"]
              },
              "description": "【回合开始】每回合费用上限+2，额外抽1张手牌并回复2生命值。"
            }
          ]
        },
        {
          "name": "Plan B",
          "entries": [
            {
              "trigger": "on_turn_start",
              "operation": {
                "op": "program",
                "code": [
                  "$player.cardspace.hand.content", "SIZE", 5, "GE",
                  ["$self", 1, "TURN_DUELS_ADD", "$player", 1, "TURN_COST_ADD"], "WHEN"
                ]
              },
              "description": "【回合开始】额外抽牌后，若手牌达到5张，本回合自身交锋数+1，己方获得1通用费。"
            }
          ]
        },
        {
          "name": "焦黄风暴",
          "entries": [
            {
              "trigger": "BEFORE FINALIZE_DAMAGE",
              "subject": "source",
              "when": [
                {"left": "$event.damage_part", "op": "eq", "right": true},
                {"left": "$event.clash_result", "op": "eq", "right": "win"},
                {"left": "$event.damage_amount", "op": "eq", "right": 0}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.damage_die.is_attack",
                  "$event.damage_die.use_state", "zero_burst_replacement", false, "LOOKUP", "NOT", "AND",
                  ["$event.value_ref", 0, "VALUE_CEILING"], "WHEN"
                ]
              },
              "description": "【拼点胜利】进攻骰拼点胜利，即将造成0点伤害的直伤部分固定为0。"
            },
            {
              "trigger": "AFTER DAMAGE",
              "subject": "source",
              "when": [
                {"left": "$event.damage_part", "op": "eq", "right": true},
                {"left": "$event.clash_result", "op": "eq", "right": "win"},
                {"left": "$event.damage_amount", "op": "eq", "right": 0},
                {"left": "$event.damage_dealt", "op": "eq", "right": true}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.damage_die.is_attack",
                  "$event.damage_die.use_state", "zero_burst_replacement", false, "LOOKUP", "NOT", "AND",
                  ["$event.target", "崩析", 1, "STATUS"], "WHEN"
                ]
              },
              "description": "上述0点直伤成功结算后视为造成伤害，对该段目标施加1层崩析。"
            },
            {
              "trigger": "AFTER DAMAGE",
              "subject": "any",
              "when": [{"left": "$event.damage_cause", "op": "eq", "right": "崩析爆发"}],
              "operation": {
                "op": "program",
                "code": ["$self", "$event.damage_amount", 2, "FLOOR_DIV", "HEAL"]
              },
              "description": "场上任意角色发生崩析爆发时，回复爆发伤害量一半的生命值（向下取整）。"
            },
            {
              "trigger": "BEFORE ACTIVATE_STATUS",
              "subject": "target",
              "when": [{"left": "$event.status", "op": "eq", "right": "崩析"}],
              "operation": {
                "op": "program",
                "code": ["$game.turn_ending", "NOT", [{"op": "cancel"}], "WHEN"]
              },
              "description": "自身在回合结束前不会触发崩析爆发。"
            },
            {
              "trigger": "before_turn_end",
              "when": [{"left": {"field": "$self.statuses", "key": "崩析", "default": 0}, "op": "ge", "right": 8}],
              "operation": {
                "op": "program",
                "code": ["$self", "崩析", "ACTIVATE_STATUS"]
              },
              "description": "【回合结束】进入回合末时，若自身仍至少持有8层崩析，立即尝试爆发。"
            }
          ]
        },
        {
          "name": "弥合裂隙",
          "entries": [
            {
              "trigger": "on_turn_start",
              "when": [{"left": {"field": "$self.statuses", "key": "崩析", "default": 0}, "op": "ge", "right": 4}],
              "operation": {
                "op": "program",
                "code": ["$self", "弥合", 1, "STATUS", "$self", "虚弱", -2, "STATUS"]
              },
              "description": "【回合开始】自身崩析不少于4层时，获得1层弥合并减少2层虚弱。"
            }
          ]
        },
        {
          "name": "狂暴毁灭",
          "entries": [
            {
              "trigger": "after_dice_use",
              "operation": {
                "op": "program",
                "code": [
                  "$event.die.is_attack", "$event.die.did_deal_damage", "NOT", "AND",
                  "$event.target.is_alive", "AND",
                  [
                    "$self", "崩析", "STATUS_COUNT", 6, "GE",
                    [{"op": "damage", "amount": 2, "grade": "pierce", "credit": "die"}],
                    [{"op": "damage", "amount": 1, "grade": "pierce", "credit": "die"}],
                    "IF_ELSE"
                  ],
                  "WHEN"
                ]
              },
              "description": "【用骰后】进攻骰使用后，若本骰未成功造成任何直伤，则对目标造成1点穿甲伤害；自身崩析不少于6层则改为2点穿甲伤害。此追伤仍受远程压制。"
            }
          ]
        },
        {
          "name": "崩析灭除",
          "entries": [
            {
              "trigger": "AFTER ACTIVATE_STATUS",
              "subject": "any",
              "hidden": true,
              "when": [
                {"left": "$event.status", "op": "eq", "right": "崩析"},
                {"left": "$event.result", "op": "eq", "right": true}
              ],
              "operation": {
                "op": "program",
                "code": [
                  "$event.die",
                  [
                    "$event.die.card.character", "$self", "IS", "$event.die.is_attack", "AND",
                    ["$event.die", "burst_during_attack", true, "SET_DIE_STATE"], "WHEN"
                  ],
                  "WHEN"
                ]
              },
              "description": "在骰子的攻击期间记录场上发生的崩析爆发。"
            },
            {
              "trigger": "after_dice_use",
              "operation": {
                "op": "program",
                "code": [
                  "$event.die.is_attack",
                  "$event.die.use_state", "burst_during_attack", false, "LOOKUP", "AND",
                  "$event.target.is_alive", "AND",
                  [
                    {
                      "schedule": {
                        "event": "on_turn_prepared",
                        "source": "$self",
                        "target": "$event.target",
                        "after_turns": 1,
                        "through_turns": 1,
                        "uses": 1,
                        "require_source_alive": false,
                        "require_target_alive": true,
                        "then": ["$event.scheduled.target", "崩离", 1, "STATUS"]
                      }
                    }
                  ],
                  "WHEN"
                ]
              },
              "description": "【用骰后】自身这颗进攻骰攻击期间发生过崩析爆发时，下回合对本骰目标施加1层崩离。"
            }
          ]
        }
      ],
