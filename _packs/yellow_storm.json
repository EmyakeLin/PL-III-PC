{
  "turn_end_statuses": ["崩裂", "弥合"],
  "status_rules": {
    "崩析": {
      "description": "每3层使进攻骰的直伤部分减1。达到8层时爆发，受到初始生命上限三分之一（向上取整）的超穿甲伤害后移除。受到直伤时下回合获得1虚弱；骰子造成至少1点直伤时传播1崩析，每骰一次。目标已有崩析则立即施加，否则在下回合施加。",
      "activation": {
        "label": "崩析爆发", "remove_after": true,
        "operation": {"op": "program", "code": ["$self", "$original_max_hp", 2, "ADD", 3, "FLOOR_DIV", "concept", "none", "DAMAGE"]}
      }
    },
    "崩裂": {"description": "本回合受到的崩析爆发伤害+X。至少2层时，每次被施加崩析额外增加1层。回合结束时，崩析+X，随后解除。"},
    "弥合": {"description": "本回合受到的崩析爆发伤害−X。至少2层时，每次被施加崩析减少1层。回合结束时，崩析−X，随后解除。"},
    "崩离": {"permanent": true, "max_hp_per_stack": -1, "description": "生命上限减少X，无法解除。"}
  },
  "status_entries": {
    "崩析": [
      {
        "trigger": "AFTER STATUS", "when": {"status": "崩析", "result_at_least": 8},
        "operation": {"op": "program", "code": ["$actual_delta", 0, "GT", ["$self", "崩析", "ACTIVATE_STATUS", "POP"], "WHEN"]}
      },
      {
        "trigger": "BEFORE RESOLVE_DAMAGE", "subject": "source", "when": {"damage_part": true},
        "operation": {"op": "program", "code": ["$damage_die_is_attack", ["$self", "崩析", "STATUS_COUNT", 3, "FLOOR_DIV", "SUB"], "WHEN"]}
      },
      {
        "trigger": "AFTER DAMAGE", "subject": "target", "when": {"damage_received": true},
        "operation": {"op": "program", "code": ["$self", "$self", "虚弱", 1, "QUEUE_STATUS"]}
      },
      {
        "trigger": "AFTER DAMAGE", "subject": "source", "when": {"damage_amount_at_least": 1},
        "operation": {"op": "program", "code": [
          "$damage_die", [
            "$damage_die", "collapse_spread", "DIE_STATE", "NOT", [
              "$damage_die", "collapse_spread", true, "SET_DIE_STATE",
              "$target", "崩析", "STATUS_COUNT", 0, "GT",
              ["$target", "崩析", 1, "STATUS"], ["$self", "$target", "崩析", 1, "QUEUE_STATUS"], "IF_ELSE"
            ], "WHEN"
          ], "WHEN"
        ]}
      }
    ],
    "崩裂": [
      {
        "trigger": "BEFORE RESOLVE_DAMAGE", "subject": "target", "when": {"damage_cause": "崩析爆发"},
        "operation": {"op": "program", "code": ["$self", "崩裂", "STATUS_COUNT", "ADD"]}
      },
      {
        "trigger": "BEFORE STATUS", "when": {"status": "崩析", "owner_status_at_least": {"崩裂": 2}},
        "operation": {"op": "program", "code": ["$amount", 0, "GT", [1, "ADD"], "WHEN"]}
      },
      {
        "trigger": "before_turn_end", "operation": {"op": "program", "code": [
          "$self", "崩析", "$self", "崩裂", "STATUS_COUNT", "STATUS", "$self", "崩裂", "all", "SPEND_STATUS", "POP"
        ]}
      }
    ],
    "弥合": [
      {
        "trigger": "BEFORE RESOLVE_DAMAGE", "subject": "target", "when": {"damage_cause": "崩析爆发"},
        "operation": {"op": "program", "code": ["$self", "弥合", "STATUS_COUNT", "SUB"]}
      },
      {
        "trigger": "BEFORE STATUS", "when": {"status": "崩析", "owner_status_at_least": {"弥合": 2}},
        "operation": {"op": "program", "code": ["$amount", 0, "GT", [1, "SUB"], "WHEN"]}
      },
      {
        "trigger": "before_turn_end", "operation": {"op": "program", "code": [
          "$self", "崩析", "$self", "弥合", "STATUS_COUNT", -1, "MUL", "STATUS", "$self", "弥合", "all", "SPEND_STATUS", "POP"
        ]}
      }
    ]
  },
  "faction": "PlanB",
  "characters": [
    {
      "id": "plan_b_sa",
      "name": "萨",
      "title": "焦黄风暴",
