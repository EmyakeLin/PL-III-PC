{
  "faction": "沉钟坊",
  "characters": [{
    "id": "bellfounder_que_ming",
    "name": "阙鸣",
    "title": "铸钟人",
    "rank": "BOSS",
    "max_hp": 17,
    "resource_rules": {"caps": {"钟振": 4}},
    "passive_skills": [
      {
        "name": "起钟",
        "entries": [{
          "trigger": "on_turn_start",
          "operation": {"op": "program", "code": [
            "$player", 1, "DRAW", "$self", "钟振", 1, "STATUS",
            "$self", "normal", "$self", "钟振", "STATUS_COUNT", 1, "ADD", 3, "MIN", "SHIELD"
          ]},
          "description": "回合开始时额外抽1张牌，获得1钟振，再获得等于当前钟振层数加1的普通护盾（至多3点）。钟振跨回合保留，上限4层。"
        }]
      },
      {
        "name": "落音",
        "entries": [{
          "trigger": "AFTER LIGHTCORE_DAMAGE",
          "subject": "source",
          "when": {"lightcore_collapsed": true},
          "turn_limit": {"key": "bellfounder_collapse", "count": 1},
          "operation": {"op": "program", "code": ["$self", "reinforced", 2, "SHIELD"]},
          "description": "每回合第一次以光点伤害引发崩塌时，自身获得2强化护盾。"
        }]
      }
    ],
    "skills": [
      {
        "id": "bellfounder_tap", "name": "试音锤", "cost": 1,
        "dice": [
          {"type": "blunt", "level": 3, "entries": ["3光点伤害"]},
          {"type": "block", "level": 2, "entries": [{
            "trigger": "on_clash_win", "operation": {"op": "status", "target": "self", "name": "钟振", "amount": 1},
            "description": "拼点胜利时获得1钟振。"
          }]}
        ]
      },
      {
        "id": "bellfounder_brace", "name": "抱钟步", "cost": 1,
        "dice": [
          {"type": "block", "level": 4, "entries": [{
            "trigger": "on_clash_win",
            "operation": {"op": "program", "code": ["$self", "normal", 2, "SHIELD", "$self", "钟振", 1, "STATUS"]},
            "description": "拼点胜利时获得2普通护盾与1钟振。"
          }]},
          {"type": "blunt", "level": 2, "entries": ["3光点伤害"]}
        ]
      },
      {
        "id": "bellfounder_offbeat", "name": "错拍", "cost": 2,
        "dice": [
          {"type": "slash", "level": 3, "entries": ["2光点伤害"]},
          {"type": "blunt", "level": 3, "entries": ["3光点伤害", {
            "trigger": "AFTER RESOLVE_HIT", "when": {"result": true},
            "operation": {"op": "program", "code": [
              "$target_alive", ["$self", "钟振", 1, "SPEND_STATUS_IN_FULL", ["$target", 2, "LIGHTCORE_DAMAGE"], "WHEN"], "WHEN"
            ]},
            "description": "命中后若目标存活，消耗1钟振以追加2光点伤害。"
          }]}
        ]
      },
      {
        "id": "bellfounder_pin", "name": "穿耳钉", "cost": 2, "ignore_range": 1,
        "dice": [
          {"type": "pierce", "level": 4, "entries": ["4光点伤害"]},
          {"type": "evade", "level": 3, "entries": [{
            "trigger": "on_clash_win",
            "operation": {"op": "program", "code": ["$self", "$self", "迅捷", 1, "QUEUE_STATUS"]},
            "description": "拼点胜利时，下回合获得1迅捷。"
          }]}
        ]
      },
      {
        "id": "bellfounder_drop", "name": "沉钟", "cost": 2,
        "dice": [{"type": "blunt", "level": 5, "base_value": 1, "entries": ["7光点伤害"]}]
      },
      {
        "id": "bellfounder_peal", "name": "复鸣", "cost": 3,
        "dice": [
          {"type": "blunt", "level": 4, "base_value": 1, "entries": ["7光点伤害", {
            "trigger": "AFTER RESOLVE_HIT", "when": {"result": true},
            "operation": {"op": "program", "code": [
              "$target_alive", ["$self", "钟振", 2, "SPEND_STATUS_IN_FULL", ["$target", 4, "LIGHTCORE_DAMAGE"], "WHEN"], "WHEN"
            ]},
            "description": "命中后若目标存活，消耗2钟振以追加4光点伤害。"
          }]},
          {"type": "block", "level": 3, "entries": [{
            "trigger": "on_clash_win", "operation": {"op": "status", "target": "self", "name": "钟振", "amount": 1},
            "description": "拼点胜利时获得1钟振。"
          }]}
        ]
      },
      {
        "id": "bellfounder_clapper", "name": "百步飞椎", "cost": 4, "range_level": 2, "pre_reveal": true,
        "entries": [{
          "trigger": "on_skill_use",
          "operation": {"op": "program", "code": [
            "$self", "钟振", "all", "SPEND_STATUS", "spent", "STORE",
            "$card", {"local": "spent"}, "SKILL_FINAL_ADD",
            {"local": "spent"}, 3, "GE", ["$card", "heavy_clapper", 1, "SET_SKILL_STATE"], "WHEN"
          ]},
          "description": "使用时消耗全部钟振，每消耗1层使本技能最终点数+1；消耗至少3层时，本技能直伤+2。"
        },{
          "trigger": "before_dice_hit",
          "operation": {"op": "program", "code": ["$card", "heavy_clapper", "SKILL_STATE", [{"op": "damage_add", "amount": 2}], "WHEN"]},
          "description": "本次已消耗至少3钟振时，对命中的直伤加2。"
        }],
        "dice": [{"type": "pierce", "level": 5, "base_value": 2, "entries": ["3穿甲"]}]
      }
    ]
  }]
}
