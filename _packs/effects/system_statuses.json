{
  "pack_type": "status_effects",
  "name": "基础体系状态效果包",
  "status_rules": {
    "烧伤": {"aliases": ["burn"]},
    "裂血": {"aliases": ["bleed"], "cap": 9, "active_from": 6, "active_label": "裂血（爆发）"},
    "呼吸": {
      "aliases": ["breath", "呼吸法"], "cap": 6, "check": {"event": "critical", "sides": 6},
      "description": "又称呼吸法，上限 6 层。自身进攻骰命中时掷一枚六面骰，结果不高于呼吸层数时，触发「暴击时」词条。"
    },
    "失衡": {
      "aliases": ["stagger"], "cap": 20,
      "description": "上限 20 层。被「失衡爆发」命中时掷一枚二十面骰。结果不高于失衡层数时，先获得 1 层致命失衡，再减少 5 层失衡。结果高于层数时，获得 2 层失衡。",
      "check": {
        "event": "stagger", "sides": 20,
        "success": {"op": "program", "code": ["$self", "致命失衡", 1, "STATUS", "$self", "失衡", -5, "STATUS"]},
        "failure": {"op": "program", "code": ["$self", "失衡", 2, "STATUS"]}
      }
    },
    "致命失衡": {"aliases": ["fatal_stagger"], "incoming_damage_multiplier": 2}
  },
  "status_entries": {
    "烧伤": [{
      "trigger": "on_character_turn_end", "damage_cause": "烧伤",
      "description": "回合结束时，若烧伤至少 4 层，每满 4 层算一组。自身承受一次普通伤害，原始伤害等于组数，至多 3 点。若入盾前的伤害量大于 0，烧伤减少「组数 + 2」层，即使护盾挡下全部伤害也照常减少。",
      "when": {"owner_status_at_least": {"烧伤": 4}},
      "operation": {"op": "program", "code": [
        "$self", "烧伤", "STATUS_COUNT", 4, "FLOOR_DIV", "units", "STORE",
        "$self", {"local": "units"}, 3, "MIN", "normal", "none", "DAMAGE_AMOUNT", 0, "GT",
        ["$self", "烧伤", 0, {"local": "units"}, 2, "ADD", "SUB", "STATUS"], "WHEN"
      ]}
    }],
    "裂血": [
      {
        "trigger": "on_character_duel_start", "damage_cause": "裂血",
        "description": "上限 9 层。持有至少 3 层时，每场交锋开始结算时承受 1 点穿甲伤害，即使自己未在该场出牌。",
        "when": {"owner_status_at_least": {"裂血": 3}},
        "operation": {"op": "program", "code": ["$self", 1, "pierce", "none", "DAMAGE"]}
      },
      {
        "trigger": "after_damage_part", "damage_cause": "裂血爆发",
        "description": "达到 6 层时进入爆发，持续至裂血归零或解除。爆发期间，每被一个伤害部分命中且仍存活，额外承受 1 点穿甲伤害，再减少 2 层裂血。0 点伤害或被护盾完全挡下的伤害部分也会触发。",
        "operation": {"op": "program", "code": [
          "$self", "裂血", "STATUS_ACTIVE",
          ["$self", 1, "pierce", "none", "DAMAGE", "$self", "裂血", -2, "STATUS"], "WHEN"
        ]}
      }
    ],
    "致命失衡": [{
      "trigger": "on_direct_damage_applied",
      "description": "持有至少 1 层时，所受直伤翻倍，多层共用这一倍率。受到至少 1 点直伤后减少 1 层，每轮用骰至多因此减少 1 层。即使护盾挡下全部伤害，也会消耗层数。",
      "operation": {"op": "program", "code": [
        "致命失衡损耗", "ONCE_PER_ROUND", ["$self", "致命失衡", -1, "STATUS"], "WHEN"
      ]}
    }]
  }
}
