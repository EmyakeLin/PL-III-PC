{
  "pack_type": "ability_effects",
  "name": "基础能力效果包",
  "ability_rules": {
    "优势次数": {
      "description": "拼点取两次变动点数中的较大值，随后用掉一次。获得时与劣势次数逐次相消。",
      "opposes": "劣势次数",
      "global_entries": [
        {
          "trigger": "BEFORE SELECT_ROLL_VALUE",
          "description": "拼点取两次变动点数中的较大值，随后消耗1次优势次数。",
          "when": [
            {"left":{"field":"$event.source.ability_effects","key":"优势次数","default":0},"op":"gt","right":0},
            {"left":{"field":"$event.die.use_state","key":"本次劣势","default":false},"op":"eq","right":false}
          ],
          "operation": {"op":"program","code":[
            "$event.die","$event.low","$event.high","$event.bonus",{"call":"SAMPLE_ROLL_VALUE","result":"result"},"second","STORE",
            "$local.second",null,"IS","NOT",[
              "$local.second","MAX","$event.source","优势次数",1,"SPEND_ABILITY_EFFECT"
            ],"WHEN"
          ]}
        },
        {
          "trigger": "BEFORE SELECT_ROLL_VALUE",
          "description": "本次拼点的即时劣势抵消一次优势，使用第一次采样。",
          "when": [
            {"left":{"field":"$event.die.use_state","key":"本次劣势","default":false},"op":"eq","right":true},
            {"left":{"field":"$event.source.ability_effects","key":"优势次数","default":0},"op":"gt","right":0}
          ],
          "operation": {"op":"program","code":["$event.source","优势次数",1,"SPEND_ABILITY_EFFECT"]}
        }
      ]
    },
    "劣势次数": {
      "description": "拼点取两次变动点数中的较小值，随后用掉一次。获得时与优势次数逐次相消。",
      "opposes": "优势次数",
      "global_entries": [
        {
          "trigger": "BEFORE SELECT_ROLL_VALUE",
          "description": "拼点取两次变动点数中的较小值，随后消耗1次劣势次数。",
          "when": [
            {"left":{"field":"$event.source.ability_effects","key":"劣势次数","default":0},"op":"gt","right":0},
            {"left":{"field":"$event.die.use_state","key":"本次劣势","default":false},"op":"eq","right":false}
          ],
          "operation": {"op":"program","code":[
            "$event.die","$event.low","$event.high","$event.bonus",{"call":"SAMPLE_ROLL_VALUE","result":"result"},"second","STORE",
            "$local.second",null,"IS","NOT",[
              "$local.second","MIN","$event.source","劣势次数",1,"SPEND_ABILITY_EFFECT"
            ],"WHEN"
          ]}
        },
        {
          "trigger": "BEFORE SELECT_ROLL_VALUE",
          "description": "本骰的即时劣势取两次采样的较低值，保留角色已有劣势次数。",
          "when": [
            {"left":{"field":"$event.die.use_state","key":"本次劣势","default":false},"op":"eq","right":true},
            {"left":{"field":"$event.source.ability_effects","key":"优势次数","default":0},"op":"eq","right":0}
          ],
          "operation": {"op":"program","code":[
            "$event.die","$event.low","$event.high","$event.bonus",{"call":"SAMPLE_ROLL_VALUE","result":"result"},"second","STORE",
            "$local.second",null,"IS","NOT",["$local.second","MIN"],"WHEN"
          ]}
        }
      ]
    },
    "置卡或换卡机会": {
      "permissions": ["place", "replace"],
      "turn_end": true
    },
    "置卡机会": {
      "permission": "place",
      "turn_end": true,
      "description": "消耗一次，将自身一张手牌置于友方第一个空常规交锋，占用一次常规交锋额度。"
    },
    "换卡机会": {
      "permission": "replace",
      "turn_end": true,
      "description": "自身技能使用前，消耗一次并以自身另一张手牌替换它。"
    }
  }
}
