{
  "pack_type": "ability_effects",
  "name": "基础能力效果包",
  "ability_rules": {
    "优势次数": {
      "description": "拼点取两次变动点数中的较大值，随后用掉一次。获得时与劣势次数逐次相消。",
      "global_entries": [
        {
          "trigger": "BEFORE ABILITY_EFFECT",
          "when": [{"left":"$event.ability","op":"eq","right":"优势次数"},{"left":"$pending.amount","op":"gt","right":0}],
          "operation": {"op":"program","code":[
            "DUP","$event.target.ability_effects","劣势次数",0,"LOOKUP","MIN","offset","STORE",
            "$local.offset",0,"GT",[
              "$event.target","劣势次数","$local.offset",{"call":"SPEND_ABILITY_EFFECT","result":"actual_delta","default":0},"ADD"
            ],"WHEN"
          ]}
        },
        {
          "trigger": "BEFORE SELECT_ROLL_VALUE",
          "when": [{"left":{"field":"$event.source.ability_effects","key":"优势次数","default":0},"op":"gt","right":0}],
          "operation": {"op":"program","code":[
            "$event.die","$event.low","$event.high","$event.bonus",{"call":"SAMPLE_ROLL_VALUE","result":"result"},"second","STORE",
            "$local.second",null,"IS","NOT",[
              "$local.second","MAX","$event.source","优势次数",1,"SPEND_ABILITY_EFFECT"
            ],"WHEN"
          ]}
        }
      ]
    },
    "劣势次数": {
      "description": "拼点取两次变动点数中的较小值，随后用掉一次。获得时与优势次数逐次相消。",
      "global_entries": [
        {
          "trigger": "BEFORE ABILITY_EFFECT",
          "when": [{"left":"$event.ability","op":"eq","right":"劣势次数"},{"left":"$pending.amount","op":"gt","right":0}],
          "operation": {"op":"program","code":[
            "DUP","$event.target.ability_effects","优势次数",0,"LOOKUP","MIN","offset","STORE",
            "$local.offset",0,"GT",[
              "$event.target","优势次数","$local.offset",{"call":"SPEND_ABILITY_EFFECT","result":"actual_delta","default":0},"ADD"
            ],"WHEN"
          ]}
        },
        {
          "trigger": "BEFORE SELECT_ROLL_VALUE",
          "when": [{"left":{"field":"$event.source.ability_effects","key":"劣势次数","default":0},"op":"gt","right":0}],
          "operation": {"op":"program","code":[
            "$event.die","$event.low","$event.high","$event.bonus",{"call":"SAMPLE_ROLL_VALUE","result":"result"},"second","STORE",
            "$local.second",null,"IS","NOT",[
              "$local.second","MIN","$event.source","劣势次数",1,"SPEND_ABILITY_EFFECT"
            ],"WHEN"
          ]}
        }
      ]
    },
    "置卡机会": {
      "permission": "place",
      "turn_end": true,
      "description": "消耗一次，将自身一张手牌置于友方第一个空常规交锋，占用一次常规交锋额度。"
    },
    "换卡机会": {
      "permission": "replace",
      "turn_end": true,
      "description": "自身技能使用前，消耗一次并以自身另一张手牌替换它。"
    }
  }
}
