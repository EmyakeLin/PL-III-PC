{
  "faction": "新星组织",
  "turn_end_statuses": ["本回合羽流判定成功"],
  "status_rules": {
    "隧道": {"description": "新星组织资源。林秋在回合开始时持有至少8层即可开启隧道。"},
    "星结": {
      "cap": 12,
      "track_overflow": true,
      "overflow_threshold": 6,
      "global_entries": [
        {
          "trigger": "on_turn_closing",
          "turn_limit": {"key":"星结锁定名单","count":1},
          "operation": {
            "op": "program",
            "code": [
              "$game.players", "$game.first_player", "FIRST_IN_ORDER", ["$event.item.characters"], "MAP",
              "FLATTEN",
              ["$event.item.is_alive","$event.item.status_overflow","星结",0,"LOOKUP",
               "$game.status_rules.星结.overflow_threshold","GE","AND"],
              "FILTER", "targets", "STORE", "$local.targets",
              [
                "$local.targets", {"literal":["targets"]}, ["on_star_lock","$event.bindings","PUBLISH"],
                "WITH_BINDINGS", "$local.targets",
                [
                  "SET_STATUS_OVERFLOW $event.item 星结 0", "$event.item.is_alive",
                  ["CAP_STATUS $event.item 星结 6"], "WHEN"
                ],
                "EACH"
              ],
              "WHEN"
            ]
          }
        }
      ],
      "description": "上限12。累计溢出跨回合保留。达到6点溢出的角色在回合结束前一同成为锁定目标，结算完毕清零累计，各目标星结至多保留6层。"
    },
    "羽流·林秋": {"cap": 12, "description": "上限12。拼赢即将命中时，d12不高于层数则追加一次命中。本回合判定至少成功三次，回合末清空。"},
    "隧道开启": {
      "requires_status": "隧道", "sustain": {"强壮": 2},
      "description": "持续至隧道归零。林秋获得2强壮，骰子等级+1，每次获得隧道的数量−1，并激活带有开启条件的词条。"
    }
  },
  "characters": [
    {
      "id": "nova_lin_qiu",
      "name": "林秋",
      "rank": "BOSS",
      "max_hp": 15,
      "passive_skills": [
        {
          "name": "新星组织 D-VII",
          "entries": [
            {
              "trigger": "on_turn_start",
              "operation": {
                "op": "program",
                "code": [
                  "$self", "隧道", 1, "$self.skills",
                  [
                    "$event.item.out_of_combat", "NOT", "$player.cardspace.hand.content", "$event.item",
                    "CONTAINS", "AND"
                  ],
                  "FILTER", "SIZE", 7, "GE", [1,"ADD"], "WHEN", "STATUS"
                ]
              },
              "description": "回合开始时获得1隧道，自己的七张牌集满时本次获得量+1。"
            }
          ]
        },
        {
          "name": "新星隧道节点 D-VII型",
          "entries": [
            {
              "trigger": "on_turn_start",
              "operation": {
                "op": "program",
                "code": [
                  "$self", "隧道", "STATUS_COUNT", 8, "GE", "$self", "隧道开启", "STATUS_COUNT", 0, "EQ", "AND",
                  ["$self", "隧道开启", 1, "STATUS"], "WHEN"
                ]
              },
              "description": "回合开始时，隧道至少8层即开启，持续至隧道解除。"
            },
            {
              "trigger": "BEFORE STATUS",
              "subject": "target",
              "when": [
                {"left":{"field":"$self.statuses","key":"隧道开启","default":0},"op":"ge","right":1},
                {"left":"$event.status","op":"eq","right":"隧道"},
                {"left":"$pending.amount","op":"ge","right":1}
              ],
              "operation": {
                "op": "program",
                "code": [1, "SUB"]
              },
              "description": "隧道开启期间，每次隧道获得量−1。"
            }
          ]
        },
        {
          "name": "隧道附刃",
          "entries": [
            {
              "trigger": "BEFORE RESOLVE_DIE_LEVEL",
              "when": [{"left":{"field":"$self.statuses","key":"隧道开启","default":0},"op":"ge","right":1}],
              "operation": {
                "op": "program",
                "code": [1, "ADD"]
              },
              "description": "隧道开启期间，骰级+1，持续提供2强壮。"
            },
            {
              "trigger": "before_dice_hit",
              "when": [{"left":{"field":"$self.statuses","key":"隧道开启","default":0},"op":"ge","right":1}],
              "operation": {
                "op": "program",
                "code": [
                  "$event.die.has_damage_part",
                  [
                    "$self", "隧道", 1,
                    {
                      "call": "SPEND_STATUS",
                      "with": {"require_full":true},
                      "result": "paid_in_full",
                      "default": false
                    },
                    ["$event.target","$event.hit_modifiers","damage_add",1,"normal","ADD_DAMAGE_MODIFIER"],
                    "WHEN"
                  ],
                  "WHEN"
                ]
              },
              "description": "开启时，命中有伤害部分的骰消耗1隧道，以使本次命中的伤害部分+1。"
            }
          ]
        },
        {
          "name": "羽流·林秋",
          "entries": [
            {
              "trigger": "on_dice_clash",
              "operation": "STATUS 羽流·林秋 1 $self",
              "description": "每实际参与一次拼点，获得1羽流·林秋（至多12）。"
            },
            {
              "trigger": "before_dice_hit",
              "when": [{"left":{"field":"$self.statuses","key":"羽流·林秋","default":0},"op":"ge","right":1}],
              "operation": {
                "op": "program",
                "code": [
                  "$event.die.use_state", "羽流额外命中", false, "LOOKUP", "NOT", "$event.die.clash_result",
                  "win", "EQ", "AND",
                  [
                    1, 12, "RANDOM_INT", "$self", "羽流·林秋", "STATUS_COUNT", "LE",
                    [
                      "$event.die", "羽流额外命中", true, "SET_DIE_STATE", "$event.die", "full", "羽流",
                      "QUEUE_HIT", "$self", "本回合羽流判定成功", 1, "STATUS"
                    ],
                    "WHEN"
                  ],
                  "WHEN"
                ]
              },
              "description": "拼赢且即将命中时，d12不高于羽流层数则额外命中一次，每次用骰限一次。"
            },
            {
              "trigger": "before_turn_end",
              "when": [{"left":{"field":"$self.statuses","key":"本回合羽流判定成功","default":0},"op":"ge","right":3}],
              "operation": {
                "op": "program",
                "code": ["$self","羽流·林秋","all",{"call":"SPEND_STATUS","result":"result","default":0},"POP"]
              },
              "description": "本回合判定至少成功三次，回合结束时清空羽流。"
            }
          ]
        },
        {
          "name": "星结标定剑柄",
          "entries": [
            {
              "trigger": "on_dice_clash",
              "when": [{"left":{"field":"$event.target.statuses","key":"星结","default":0},"op":"ge","right":8}],
              "operation": {"op":"program","code":["$event.die",1,"DIE_BASE_ADD"]},
              "description": "与至少8星结的目标拼点时，基础值+1。"
            },
            {
              "trigger": "before_clash_result",
              "when": [{"left":{"field":"$event.target.statuses","key":"星结","default":0},"op":"ge","right":8}],
              "operation": {
                "op": "program",
                "code": [
                  "$event.die.is_attack", "$event.die.value", 2, "MUL", "$event.die.roll_max", "GT",
                  "AND", ["$event.card","resident_die","$event.die","SET_SKILL_STATE"], "WHEN"
                ]
              },
              "description": "目标至少8星结，且进攻骰本次变动点数超过当次上限的一半，成为驻留骰。"
            },
            {
              "trigger": "on_clash_lose",
              "operation": {
                "op": "program",
                "code": [
                  "$event.card.use_state", "resident_die", null, "LOOKUP", "$event.die", "EQ",
                  ["$event.die","damage_only","星结标定剑柄","QUEUE_HIT"], "WHEN"
                ]
              },
              "description": "驻留骰拼输仍命中，只结算伤害部分，伤害−1。"
            },
            {
              "trigger": "before_dice_hit",
              "when": [{"left":"$event.hit_origin","op":"eq","right":"星结标定剑柄"}],
              "operation": {
                "op": "program",
                "code": ["$event.target","$event.hit_modifiers","damage_add",-1,"concept","ADD_DAMAGE_MODIFIER"]
              },
              "description": "驻留败方的伤害部分−1。"
            }
          ]
        },
        {
          "name": "星结锁定·补给",
          "entries": [
            {
              "trigger": "on_star_lock",
              "operation": {
                "op": "program",
                "code": [
                  "$event.targets", ["$event.target","星结",2,"STATUS"], "FOR_EACH_TARGET",
                  "$player.characters", ["$event.item.is_alive"], "FILTER", ["$event.target",1,"HEAL"],
                  "FOR_EACH_TARGET", "$self", "隧道", 3, "STATUS"
